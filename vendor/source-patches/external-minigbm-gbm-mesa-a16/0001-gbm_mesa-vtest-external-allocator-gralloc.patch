diff --git a/Android.bp b/Android.bp
index d044e7d..e9bbef0 100644
--- a/Android.bp
+++ b/Android.bp
@@ -323,3 +323,57 @@ cc_library_shared {
     defaults: ["minigbm_cros_gralloc0_defaults"],
     shared_libs: ["libminigbm_gralloc_arcvm"],
 }
+
+// gbm_mesa / vtest external-allocator gralloc (bd remora-4ei.56).
+//
+// Roman Stratiienko's gbm_mesa backend (Apache-2.0, see its headers). Unlike every other variant
+// here, this backend does NOT allocate through a local DRM device: it delegates allocation to an
+// out-of-process allocator behind libgbm_mesa_wrapper.so. That is what lets buffers be created
+// host-side — the host's Venus vtest server allocates NVIDIA block-linear dmabufs over the Venus
+// vtest socket, so an NVIDIA-rendered buffer is not misread as Intel-tiled. DRV_EXTERNAL swaps
+// drv_get_backend() for the fixed external backend and is confined to this library's cflags,
+// exactly as DRV_I915/DRV_XE are to the intel variant.
+filegroup {
+    name: "minigbm_gbm_mesa_internal_files",
+    srcs: ["gbm_mesa_driver/gbm_mesa_internals.cpp"],
+}
+
+filegroup {
+    name: "minigbm_gbm_mesa_backend_files",
+    srcs: ["gbm_mesa_driver/gbm_mesa_driver.cpp"],
+}
+
+cc_library_shared {
+    name: "libminigbm_gralloc_gbm_mesa",
+    defaults: ["minigbm_cros_gralloc_library_defaults"],
+    cflags: ["-DDRV_EXTERNAL"],
+    srcs: [
+        ":minigbm_gbm_mesa_internal_files",
+        ":minigbm_gbm_mesa_backend_files",
+    ],
+    cpp_std: "c++17",
+    enabled: false,
+    arch: {
+        x86: {
+            enabled: true,
+        },
+        x86_64: {
+            enabled: true,
+        },
+    },
+}
+
+cc_library_shared {
+    name: "gralloc.minigbm_gbm_mesa",
+    defaults: ["minigbm_cros_gralloc0_defaults"],
+    shared_libs: ["libminigbm_gralloc_gbm_mesa"],
+    enabled: false,
+    arch: {
+        x86: {
+            enabled: true,
+        },
+        x86_64: {
+            enabled: true,
+        },
+    },
+}
diff --git a/drv.c b/drv.c
index c1f9c4f..a6911c2 100644
--- a/drv.c
+++ b/drv.c
@@ -28,6 +28,36 @@
 #include "drv_priv.h"
 #include "util.h"
 
+#ifdef DRV_EXTERNAL
+/*
+ * External-allocator build (gbm_mesa/vtest gralloc): there is no local DRM device to probe —
+ * every allocation is served by an out-of-process allocator, so the backend is fixed at compile
+ * time and drv->fd is never used to allocate. Confined to the libminigbm_gralloc_gbm_mesa
+ * variant by its own cflags, exactly as DRV_I915/DRV_XE are to the intel one (bd remora-4ei.56).
+ */
+extern struct backend *init_external_backend(void);
+
+static const struct backend *drv_get_backend(int fd)
+{
+	return init_external_backend();
+}
+
+/*
+ * cros_gralloc_driver.cc calls drv_preload() from a static initializer, so it must exist in EVERY
+ * variant — the non-external definition below lives between drv_backend_list and drv_get_backend
+ * and is therefore inside the #else, which is exactly how this went missing and failed to link.
+ * One backend here instead of a list; the gbm_mesa backend sets no .preload, so this is a no-op
+ * today and stays correct if one is ever added.
+ */
+void drv_preload(bool load)
+{
+	const struct backend *b = init_external_backend();
+
+	if (b && b->preload)
+		b->preload(load);
+}
+#else
+
 #ifdef DRV_AMDGPU
 extern const struct backend backend_amdgpu;
 #endif
@@ -114,6 +144,7 @@ static const struct backend *drv_get_backend(int fd)
 	drmFreeVersion(drm_version);
 	return NULL;
 }
+#endif /* DRV_EXTERNAL */
 
 struct driver *drv_create(int fd)
 {
@@ -543,6 +574,15 @@ void *drv_bo_map(struct bo *bo, const struct rectangle *rect, uint32_t map_flags
 	}
 
 	memcpy(mapping.vma->map_strides, bo->meta.strides, sizeof(mapping.vma->map_strides));
+	/*
+	 * An external allocator's CPU-map stride can differ from the allocation stride (the host
+	 * picks the layout; only the mapping is linear). Ask the backend when it can tell us.
+	 */
+	if ((bo->meta.use_flags & BO_USE_SW_MASK) && drv->backend->bo_get_map_stride) {
+		const uint32_t ms = drv->backend->bo_get_map_stride(bo);
+		for (size_t mp = 0; mp < ARRAY_SIZE(mapping.vma->map_strides); mp++)
+			mapping.vma->map_strides[mp] = ms;
+	}
 	addr = drv->backend->bo_map(bo, mapping.vma, map_flags);
 	if (addr == MAP_FAILED) {
 		*map_data = NULL;
@@ -680,6 +720,10 @@ int drv_bo_get_plane_fd(struct bo *bo, size_t plane)
 	if (bo->is_test_buffer)
 		return -EINVAL;
 
+	/* Backported A17 dispatch (see drv_priv.h): an external backend exports its own fd. */
+	if (bo->drv->backend->bo_export)
+		return bo->drv->backend->bo_export(bo, plane);
+
 	ret = drmPrimeHandleToFD(bo->drv->fd, bo->handle.u32, DRM_CLOEXEC | DRM_RDWR, &fd);
 
 	// Older DRM implementations blocked DRM_RDWR, but gave a read/write mapping anyways
diff --git a/drv_priv.h b/drv_priv.h
index 337b58e..0b20376 100644
--- a/drv_priv.h
+++ b/drv_priv.h
@@ -93,6 +93,14 @@ struct backend {
 	/* Called on free if this bo is the last object referencing the contained GEM BOs */
 	int (*bo_destroy)(struct bo *bo);
 	int (*bo_import)(struct bo *bo, struct drv_import_fd_data *data);
+	/*
+	 * Backported from AOSP's A17 minigbm (upstream has it at exactly this spot): the op
+	 * drv_bo_get_plane_fd dispatches to. A16's core called drmPrimeHandleToFD(drv->fd)
+	 * directly, which the external gbm_mesa backend cannot survive — it has NO local DRM
+	 * fd, allocation is delegated out-of-process. Optional here, unlike A17 where every
+	 * backend implements it: A16's in-tree backends keep the legacy path below.
+	 */
+	int (*bo_export)(struct bo *bo, size_t plane);
 	void *(*bo_map)(struct bo *bo, struct vma *vma, uint32_t map_flags);
 	int (*bo_unmap)(struct bo *bo, struct vma *vma);
 	int (*bo_invalidate)(struct bo *bo, struct mapping *mapping);
@@ -104,6 +112,12 @@ struct backend {
 	int (*resource_info)(struct bo *bo, uint32_t strides[DRV_MAX_PLANES],
 			     uint32_t offsets[DRV_MAX_PLANES], uint64_t *format_modifier);
 	uint32_t (*get_max_texture_2d_size)(struct driver *drv);
+	/*
+	 * External-allocator backends (DRV_EXTERNAL, e.g. gbm_mesa/vtest) hand back buffers whose
+	 * CPU-map stride differs from meta.strides: the allocation is made host-side and only the
+	 * mapping is linear. Optional — when absent drv_bo_map keeps meta.strides.
+	 */
+	uint32_t (*bo_get_map_stride)(struct bo *bo);
 };
 
