+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "gbm_mesa_internals.h"
+
+#include "drv_priv.h"
+#include "util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * AOSP's bo_map has no plane parameter -- it maps the whole BO -- while the upstream gbm_mesa
+ * implementation takes one. Plane is unused in that implementation (it sizes the mapping from
+ * bo->meta.total_size), so 0 is the faithful translation rather than a guess.
+ */
+static void *gbm_mesa_bo_map_whole(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	return gbm_mesa_bo_map(bo, vma, 0, map_flags);
+}
+
+/*
+ * Field order follows AOSP's struct backend exactly: designated initializers out of declaration
+ * order are a -Wreorder-init-list warning, and this file is built -Werror.
+ */
+/*
+ * AOSP declares backend::name as char*, not const char*. In C (where every other backend lives) a
+ * string literal converts implicitly; in this C++ translation unit it does not, and minigbm builds
+ * with -Wcast-qual -Werror so casting the const away is rejected too. A mutable array is the one
+ * form that satisfies both.
+ */
+static char gbm_mesa_backend_name[] = "gbm_mesa";
+
+struct backend gbm_mesa_backend = {
+	.name = gbm_mesa_backend_name,
+	.init = gbm_mesa_driver_init,
+	.close = gbm_mesa_driver_close,
+	.bo_create = gbm_mesa_bo_create,
+	.bo_destroy = gbm_mesa_bo_destroy,
+	.bo_import = gbm_mesa_bo_import,
+	/*
+	 * AOSP calls this op bo_export and drv_bo_get_plane_fd dispatches straight to it: same
+	 * signature (struct bo *, size_t plane), same contract (dmabuf fd for the plane).
+	 */
+	.bo_export = gbm_mesa_bo_get_plane_fd,
+	.bo_map = gbm_mesa_bo_map_whole,
+	.bo_unmap = gbm_mesa_bo_unmap,
+	.resolve_format_and_use_flags = gbm_mesa_resolve_format_and_use_flags,
+	.bo_get_map_stride = gbm_mesa_bo_get_map_stride,
+};
+
+struct backend *init_external_backend()
+{
+	return &gbm_mesa_backend;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
new file mode 100644
index 0000000..07104a7
--- /dev/null
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -0,0 +1,502 @@
+/*
+ * Copyright (C) 2021-2022 Roman Stratiienko (r.stratiienko@gmail.com)
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
