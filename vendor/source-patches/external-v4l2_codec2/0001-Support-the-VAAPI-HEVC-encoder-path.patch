diff --git a/components/EncodeInterface.cpp b/components/EncodeInterface.cpp
index 12152e6..9924150 100644
--- a/components/EncodeInterface.cpp
+++ b/components/EncodeInterface.cpp
@@ -38,9 +38,12 @@ constexpr float kDefaultFrameRate = 30.0;
 // The default output bitrate in bits per second. Use the max bitrate of AVC Level1.0 as default.
 constexpr uint32_t kDefaultBitrate = 64000;
 
-// The maximal output bitrate in bits per second. It's the max bitrate of AVC Level4.1.
-// TODO: increase this in the future for supporting higher level/resolution encoding.
-constexpr uint32_t kMaxBitrate = 50000000;
+// The maximal output bitrate in bits per second. Raised well above the old AVC-Level4.1 cap
+// (50 Mbps) so full-res 4K HW HEVC targets (e.g. a 150 Mbps daily-driver bitrate) are accepted:
+// the C2 bitrate param is a StrictValue with .inRange(0, kMaxBitrate), so an over-cap request was
+// silently rejected and the encoder fell back to kDefaultBitrate (64 kbps) → maxed QP → blocky.
+// 500 Mbps covers our High-tier level headroom and stays well inside uint32.
+constexpr uint32_t kMaxBitrate = 500000000;
 }  // namespace
 
 //static
@@ -134,6 +137,28 @@ C2R EncodeInterface::H264ProfileLevelSetter(bool /*mayBlock*/,
     return C2R::Ok();
 }
 
+// static
+C2R EncodeInterface::HEVCProfileLevelSetter(bool /*mayBlock*/,
+                                            C2P<C2StreamProfileLevelInfo::output>& info,
+                                            const C2P<C2StreamPictureSizeInfo::input>& /*videoSize*/,
+                                            const C2P<C2StreamFrameRateInfo::output>& /*frameRate*/,
+                                            const C2P<C2StreamBitrateInfo::output>& /*bitrate*/) {
+    constexpr C2Config::profile_t minProfile = C2Config::PROFILE_HEVC_MAIN;
+    if (!info.F(info.v.profile).supportsAtAll(info.v.profile) || info.v.profile < minProfile) {
+        if (info.F(info.v.profile).supportsAtAll(minProfile)) {
+            info.set().profile = minProfile;
+        } else {
+            return C2R(C2SettingResultBuilder::BadValue(info.F(info.v.profile)));
+        }
+    }
+    // The VF handles up to 4K and the encoder writes its own level_idc into the packed SPS, so a
+    // fixed conservative level here is enough for the framework/mirror negotiation.
+    if (!info.F(info.v.level).supportsAtAll(info.v.level)) {
+        info.set().level = C2Config::LEVEL_HEVC_MAIN_5_1;
+    }
+    return C2R::Ok();
+}
+
 C2R EncodeInterface::VP9ProfileLevelSetter(bool /*mayBlock*/,
                                            C2P<C2StreamProfileLevelInfo::output>& info,
                                            const C2P<C2StreamPictureSizeInfo::input>& /*videoSize*/,
@@ -303,6 +328,25 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
                                                  C2Config::LEVEL_VP9_6_2})})
                         .withSetter(VP9ProfileLevelSetter, mInputVisibleSize, mFrameRate, mBitrate)
                         .build());
+    } else if (caps.codec == VideoCodec::HEVC) {
+        outputMime = MEDIA_MIMETYPE_VIDEO_HEVC;
+        C2Config::profile_t minProfile = static_cast<C2Config::profile_t>(
+                *std::min_element(profiles.begin(), profiles.end()));
+        addParameter(
+                DefineParam(mProfileLevel, C2_PARAMKEY_PROFILE_LEVEL)
+                        .withDefault(new C2StreamProfileLevelInfo::output(
+                                0u, minProfile, C2Config::LEVEL_HEVC_MAIN_5_1))
+                        .withFields({C2F(mProfileLevel, profile).oneOf(profiles),
+                                     C2F(mProfileLevel, level)
+                                             .oneOf({C2Config::LEVEL_HEVC_MAIN_3,
+                                                     C2Config::LEVEL_HEVC_MAIN_3_1,
+                                                     C2Config::LEVEL_HEVC_MAIN_4,
+                                                     C2Config::LEVEL_HEVC_MAIN_4_1,
+                                                     C2Config::LEVEL_HEVC_MAIN_5,
+                                                     C2Config::LEVEL_HEVC_MAIN_5_1,
+                                                     C2Config::LEVEL_HEVC_MAIN_5_2})})
+                        .withSetter(HEVCProfileLevelSetter, mInputVisibleSize, mFrameRate, mBitrate)
+                        .build());
     } else {
         ALOGE("Unsupported component name: %s", name.c_str());
         mInitStatus = C2_BAD_VALUE;
@@ -314,9 +358,17 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
                     .withConstValue(new C2StreamBufferTypeSetting::input(0u, C2BufferData::GRAPHIC))
                     .build());
 
+    // C2MemoryUsage::CPU_READ is included so gralloc allocates the encoder's input surface LINEAR:
+    // minigbm (cros_gralloc, androidboot.remora_gralloc=minigbm_intel) would otherwise pick an
+    // X-tiled layout for a no-SW-usage render target, which the VAAPI encoder's DRM_PRIME import
+    // (and the RGBX layout probe's CPU lock) both read as linear → scrambled frames / init failure.
+    // NB: this param is in the C2MemoryUsage bit-space, NOT android BufferUsage —
+    // BufferUsage::CPU_READ_OFTEN (=3) would set C2MemoryUsage::READ_PROTECTED (1<<1) and make
+    // every input buffer protected-content, which aborts SurfaceFlinger's Skia texture creation.
     addParameter(DefineParam(mInputMemoryUsage, C2_PARAMKEY_INPUT_STREAM_USAGE)
                          .withConstValue(new C2StreamUsageTuning::input(
-                                 0u, static_cast<uint64_t>(BufferUsage::VIDEO_ENCODER)))
+                                 0u, static_cast<uint64_t>(BufferUsage::VIDEO_ENCODER) |
+                                             static_cast<uint64_t>(C2MemoryUsage::CPU_READ)))
                          .build());
 
     addParameter(
