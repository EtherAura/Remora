From 6febe50371a379029566e68b246ae079480927e6 Mon Sep 17 00:00:00 2001
From: Remora <remora@localhost>
Date: Mon, 13 Jul 2026 01:21:55 -0400
Subject: [PATCH] DecodeComponent: report picture-size changes via configUpdate
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adaptive streams switch resolution mid-stream. The component updated the
buffer's crop but never pushed the new picture size (raw.size /
C2StreamPictureSizeInfo::output), so after an upswitch CCodec emitted an
output format with the OLD width/height and a crop rect larger than them
(observed: width=426 height=240 crop(0,0,1215,683) on Pluto TV live).
ExoPlayer stalls on the incoherent format within a second.

Report the visible size on every change, through the interface config plus
a configUpdate on the carrying work — the same pattern C2SoftAvcDec uses.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Change-Id: I26585b0c2a8b85414cc44010a2d2cb4998265454
---
 components/DecodeComponent.cpp                | 23 +++++++++++++++++++
 .../v4l2_codec2/components/DecodeComponent.h  |  6 +++++
 2 files changed, 29 insertions(+)

diff --git a/components/DecodeComponent.cpp b/components/DecodeComponent.cpp
index 00880d7..0476307 100644
--- a/components/DecodeComponent.cpp
+++ b/components/DecodeComponent.cpp
@@ -523,6 +523,29 @@ void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
     }
     C2Work* work = it->second.get();
 
+    // Report picture-size changes to the framework. Adaptive streams switch resolution
+    // mid-stream; without a raw.size configUpdate CCodec keeps the previous dimensions and
+    // hands the app a format whose crop rect exceeds its width/height (ExoPlayer stalls on
+    // the incoherent format right after an upswitch). Same pattern as C2SoftAvcDec.
+    const Rect visibleRect = frame->getVisibleRect();
+    const int32_t visibleWidth = visibleRect.getWidth();
+    const int32_t visibleHeight = visibleRect.getHeight();
+    if (visibleWidth > 0 && visibleHeight > 0 &&
+        (visibleWidth != mReportedWidth || visibleHeight != mReportedHeight)) {
+        C2StreamPictureSizeInfo::output size(0u, visibleWidth, visibleHeight);
+        std::vector<std::unique_ptr<C2SettingResult>> failures;
+        c2_status_t err = mIntfImpl->config({&size}, C2_MAY_BLOCK, &failures);
+        if (err == C2_OK) {
+            ALOGI("Reporting picture size change %dx%d -> %dx%d", mReportedWidth,
+                  mReportedHeight, visibleWidth, visibleHeight);
+            work->worklets.front()->output.configUpdate.push_back(C2Param::Copy(size));
+            mReportedWidth = visibleWidth;
+            mReportedHeight = visibleHeight;
+        } else {
+            ALOGE("Failed to config picture size %dx%d: %d", visibleWidth, visibleHeight, err);
+        }
+    }
+
     C2ConstGraphicBlock constBlock = std::move(frame)->getGraphicBlock();
     std::shared_ptr<C2Buffer> buffer = C2Buffer::CreateGraphicBuffer(std::move(constBlock));
     if (mPendingColorAspectsChange &&
diff --git a/components/include/v4l2_codec2/components/DecodeComponent.h b/components/include/v4l2_codec2/components/DecodeComponent.h
index 27905c7..bc70732 100644
--- a/components/include/v4l2_codec2/components/DecodeComponent.h
+++ b/components/include/v4l2_codec2/components/DecodeComponent.h
@@ -112,6 +112,12 @@ protected:
     // The order is display order.
     std::queue<int32_t> mOutputBitstreamIds;
 
+    // The picture size last reported to the framework via a configUpdate. Adaptive streams
+    // change resolution mid-stream; raw.size must track it or CCodec keeps handing the app a
+    // format whose crop exceeds its width/height.
+    int32_t mReportedWidth = 0;
+    int32_t mReportedHeight = 0;
+
     // Set to true when decoding the protected playback.
     bool mIsSecure = false;
     // The component state.
