From 60685fff8e0fe5dc891193f6ee79fe77921b901e Mon Sep 17 00:00:00 2001
From: Remora <remora@local>
Date: Sat, 25 Jul 2026 10:48:54 -0400
Subject: [PATCH 9002/9003] Remora: forward-port TopLevelSettings large-screen
 homepage icons to AOSP 17

Upstream 'TopLevelSettings: Fix homepage icons hiding on tablets' does not apply:
its import hunk expects a different import block. The method body it targets is
byte-identical in AOSP 17, so this is the same change placed against the current
imports. SettingsThemeHelper.isTablet and WindowManager.LARGE_SCREEN_SMALLEST_
SCREEN_WIDTH_DP both exist in the A17 tree (the former Kotlin @JvmStatic).

Change-Id: If1baeb097de2909ec2becc164627110114274e26
---
 .../android/settings/homepage/TopLevelSettings.java  | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/com/android/settings/homepage/TopLevelSettings.java b/src/com/android/settings/homepage/TopLevelSettings.java
index e2e6fb93442..12f70679334 100644
--- a/src/com/android/settings/homepage/TopLevelSettings.java
+++ b/src/com/android/settings/homepage/TopLevelSettings.java
@@ -30,6 +30,7 @@ import android.util.Log;
 import android.view.LayoutInflater;
 import android.view.View;
 import android.view.ViewGroup;
+import android.view.WindowManager;
 import android.view.WindowInsets;
 
 import androidx.annotation.NonNull;
@@ -226,7 +227,16 @@ public class TopLevelSettings extends DashboardFragment implements SplitLayoutLi
     public void onSplitLayoutChanged(boolean isRegularLayout) {
         iteratePreferences(preference -> {
             if (preference instanceof HomepagePreferenceLayout) {
-                ((HomepagePreferenceLayout) preference).getHelper().setIconVisible(isRegularLayout);
+                // Lineage: keep homepage icons on large screens even in the split layout.
+                // isTablet() reads ro.build.characteristics, which a container does not set, so
+                // the smallestScreenWidthDp test is what actually carries this here.
+                Context context = getContext();
+                boolean isLargeScreen = SettingsThemeHelper.isTablet(context)
+                        || (context != null && context.getApplicationContext()
+                                .getResources().getConfiguration().smallestScreenWidthDp
+                                >= WindowManager.LARGE_SCREEN_SMALLEST_SCREEN_WIDTH_DP);
+                ((HomepagePreferenceLayout) preference).getHelper()
+                        .setIconVisible(isRegularLayout || isLargeScreen);
             }
         });
     }
