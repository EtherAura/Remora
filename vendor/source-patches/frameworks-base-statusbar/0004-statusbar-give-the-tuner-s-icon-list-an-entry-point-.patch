+package com.android.systemui.tuner;
+
+import android.os.Bundle;
+
+import androidx.preference.PreferenceFragment;
+
+import com.android.systemui.res.R;
+
+/**
+ * The status bar icon list of {@link R.xml#tuner_prefs}, hosted as a screen in its own right so
+ * that it can be entered directly rather than only by descending through {@link TunerFragment}.
+ *
+ * {@link TunerActivity.SubSettingsFragment} cannot serve this route: it lifts its preferences out
+ * of a parent {@link TunerFragment} reached via getTargetFragment(), and an intent entry has no
+ * parent to lift them from. Inflating the sub-screen by key is the equivalent that stands alone.
+ */
+public class StatusBarTunerFragment extends PreferenceFragment {
+
+    private static final String KEY_STATUS_BAR = "status_bar";
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        setPreferencesFromResource(R.xml.tuner_prefs, KEY_STATUS_BAR);
+    }
+
+    @Override
+    public void onActivityCreated(Bundle savedInstanceState) {
+        super.onActivityCreated(savedInstanceState);
+        getActivity().getActionBar().setDisplayHomeAsUpEnabled(true);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        getActivity().setTitle(R.string.status_bar);
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/tuner/TunerActivity.java b/packages/SystemUI/src/com/android/systemui/tuner/TunerActivity.java
index d0817d736f07..c601ec1e0ec7 100644
--- a/packages/SystemUI/src/com/android/systemui/tuner/TunerActivity.java
+++ b/packages/SystemUI/src/com/android/systemui/tuner/TunerActivity.java
@@ -43,6 +43,11 @@ public class TunerActivity extends Activity implements
 
     private static final String TAG_TUNER = "tuner";
 
+    // Fired by LineageParts' Settings > System > Status bar > "System icons". AOSP declares no
+    // handler for it, so without this route that preference throws ActivityNotFoundException.
+    private static final String ACTION_STATUS_BAR_TUNER =
+            "com.android.settings.action.STATUS_BAR_TUNER";
+
     private final DemoModeController mDemoModeController;
     private final TunerService mTunerService;
     private final GlobalSettings mGlobalSettings;
@@ -74,9 +79,12 @@ public class TunerActivity extends Activity implements
             final String action = getIntent().getAction();
             boolean showDemoMode = action != null && action.equals(
                     "com.android.settings.action.DEMO_MODE");
+            boolean showStatusBar = action != null && action.equals(ACTION_STATUS_BAR_TUNER);
             final PreferenceFragment fragment = showDemoMode
                     ? new DemoModeFragment(mDemoModeController, mGlobalSettings)
-                    : new TunerFragment(mTunerService);
+                    : showStatusBar
+                            ? new StatusBarTunerFragment()
+                            : new TunerFragment(mTunerService);
             getFragmentManager().beginTransaction().replace(R.id.content_frame,
                     fragment, TAG_TUNER).commit();
         }
