                     src_rect ? *src_rect : default_rect(&s->layers[layer]),
                     dst_rect ? *dst_rect : default_rect(&s->layers[layer]));
+   /* The graphics shader needs source pixel coordinates when the imported
+    * dma-buf texture includes padding absent from the guest resource size. */
+   s->layers[layer].zw.x = v->texture->width0;
 }
 
