+int vtest_resource_read_gpu(uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t req[VCMD_RESOURCE_READ_GPU_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + VCMD_RESOURCE_READ_GPU_RESP_SIZE];
+   uint32_t *resp = &resp_buf[VTEST_CMD_DATA_START];
+   void *data = NULL;
+   int ret;
+
+   if (length_dw != VCMD_RESOURCE_READ_GPU_SIZE)
+      return -EINVAL;
+
+   ret = ctx->input->read(ctx->input, req, sizeof(req));
+   if (ret != sizeof(req))
+      return -1;
+
+   int fd = vtest_receive_fd(ctx->input->data.fd);
+   if (fd < 0)
+      return report_failed_call("vtest_receive_fd", fd);
+
+   const uint32_t width = req[VCMD_RESOURCE_READ_GPU_WIDTH];
+   const uint32_t height = req[VCMD_RESOURCE_READ_GPU_HEIGHT];
+   const uint32_t drm_format = req[VCMD_RESOURCE_READ_GPU_FORMAT];
+   const uint64_t modifier = req[VCMD_RESOURCE_READ_GPU_MODIFIER_LO] |
+                             (uint64_t)req[VCMD_RESOURCE_READ_GPU_MODIFIER_HI] << 32;
+   const uint32_t row_stride = req[VCMD_RESOURCE_READ_GPU_ROW_STRIDE];
+   const uint64_t data_size = (uint64_t)row_stride * height;
+
+   /* Same geometry bounds as the allocator, plus a payload ceiling: a
+    * 32768-wide RGBA row is 128 KiB, so 512 MiB covers every real screen and
+    * still refuses a corrupt request before it can malloc the moon. */
+   if (!width || !height || width > 32768 || height > 32768 ||
+       req[VCMD_RESOURCE_READ_GPU_FLAGS] != 0 ||
+       !data_size || data_size > (512ull << 20)) {
+      ret = -EINVAL;
+   } else if (!(data = malloc(data_size))) {
+      ret = -ENOMEM;
+   } else {
+      ret = vtest_gpu_read_image(fd, width, height, drm_format, modifier,
+                                 row_stride, data);
+   }
+   close(fd);
+
+   /* one line per readback: screenshots are rare and this is the whole
+    * story of whether the detile served them (bd remora-c1e) */
+   fprintf(stderr, "[remora-readback] %ux%u fourcc=%c%c%c%c mod=0x%" PRIx64
+           " row_stride=%u -> %s\n", width, height,
+           (char)(drm_format & 0xff), (char)((drm_format >> 8) & 0xff),
+           (char)((drm_format >> 16) & 0xff), (char)((drm_format >> 24) & 0xff),
+           modifier, row_stride, ret ? strerror(-ret) : "ok");
+
+   memset(resp_buf, 0, sizeof(resp_buf));
+   resp_buf[VTEST_CMD_LEN] = VCMD_RESOURCE_READ_GPU_RESP_SIZE;
+   resp_buf[VTEST_CMD_ID] = VCMD_RESOURCE_READ_GPU;
+   resp[VCMD_RESOURCE_READ_GPU_RESP_STATUS] = ret ? (uint32_t)-ret : 0;
+   resp[VCMD_RESOURCE_READ_GPU_RESP_DATA_LO] = ret ? 0 : (uint32_t)data_size;
+   resp[VCMD_RESOURCE_READ_GPU_RESP_DATA_HI] = ret ? 0 : (uint32_t)(data_size >> 32);
+
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   if (ret >= 0 && !resp[VCMD_RESOURCE_READ_GPU_RESP_STATUS])
+      ret = vtest_block_write(ctx->out_fd, data, data_size);
+
+   free(data);
+   return ret >= 0 ? 0 : ret;
+}
