From 2b7be1c5300d04be978ecc21c51f08b02bfbec10 Mon Sep 17 00:00:00 2001
From: Remora <remora@localhost>
Date: Fri, 31 Jul 2026 22:03:46 -0400
Subject: [PATCH 08/16] venus: label the display and expose its current frame
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

vkr_remora_display_frame() now reports the newest display frame's res_id, dma_buf
fd and extent — everything a host-side encoder needs, with no pixels copied.

The display is labelled by EXTENT, once, as the largest render target. Measured:
targets are 3760x1992 (the display), 3760x234 and 3760x56 (nav and status bar
layers) and assorted smaller ones, so it is unambiguous. 111 of 142 frames
labelled DISPLAY over one session, cycling res_id 12/14/15/16 with stable fds.

Labelling once is what the res_id chain buys. The alternative — "most recent
allocation of the right size" — is a heuristic that would silently follow the
wrong target, and with a fixed buffer pool it is CONSTANT after startup anyway
(measured earlier: 32 display-sized allocations before 14 swipes, 32 after).

Each render-server process labels independently, which is why several
[remora-display] lines appear; the one serving the display settles on 3760x1992.

Third of three changes landed and verified separately, after the combined attempt
regressed everything with nothing to bisect.
---
 src/venus/vkr_remora_track.c | 46 +++++++++++++++++++++++++++++++++---
 src/venus/vkr_remora_track.h | 12 ++++++++++
 2 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/src/venus/vkr_remora_track.c b/src/venus/vkr_remora_track.c
index bad10341..a2a86095 100644
--- a/src/venus/vkr_remora_track.c
+++ b/src/venus/vkr_remora_track.c
@@ -35,6 +35,10 @@ static struct handle_map map_cmd_view;   /* VkCommandBuffer -> VkImageView */
 static struct handle_map map_fb_view;    /* VkFramebuffer  -> VkImageView (attach 0) */
 static struct handle_map map_img_wh;     /* VkImage        -> (w<<32)|h */
 static struct handle_map map_res_fd;     /* res_id         -> dup'd dma_buf fd */
+
+/* The labelled display, and the newest frame seen for it. */
+static uint32_t disp_w, disp_h, disp_res_id;
+static int disp_fd = -1;
 static uint32_t last_frame_res_id;
 /* Per-link counters: with a five-link chain, "no frames" is uninformative —
  * these say WHICH link is missing. */
@@ -288,15 +292,33 @@ vkr_remora_note_submit(const VkCommandBuffer *cmds, uint32_t count)
          continue;
 
       n_resolved++;
+
+      /* Label the display on the largest target seen, once it grows. A frame
+       * matching that extent is a display frame, and its fd is what an encoder
+       * wants. */
+      const uint64_t _wh = map_get(&map_img_wh, image);
+      const uint32_t _w = (uint32_t)(_wh >> 32), _h = (uint32_t)_wh;
+      if (_w && _h && (uint64_t)_w * _h > (uint64_t)disp_w * disp_h) {
+         disp_w = _w;
+         disp_h = _h;
+         fprintf(stderr, "[remora-display] labelled %ux%u\n", _w, _h);
+      }
+      if (_w == disp_w && _h == disp_h && disp_w) {
+         const int fd = (int)map_get(&map_res_fd, res_id);
+         disp_res_id = (uint32_t)res_id;
+         disp_fd = fd ? fd : -1;
+      }
       if ((uint32_t)res_id != last_frame_res_id) {
          /* Only on CHANGE: a compositor submits every frame, and logging each
           * one would bury the signal. The interesting event is the render
           * target rotating through the display's buffer pool. */
          {
             const uint64_t wh = map_get(&map_img_wh, image);
-            fprintf(stderr, "[remora-frame] res_id=%u %ux%u fd=%d\n", (uint32_t)res_id,
-                    (uint32_t)(wh >> 32), (uint32_t)wh,
-                    (int)map_get(&map_res_fd, res_id));
+            fprintf(stderr, "[remora-frame] res_id=%u %ux%u fd=%d%s\n",
+                    (uint32_t)res_id, (uint32_t)(wh >> 32), (uint32_t)wh,
+                    (int)map_get(&map_res_fd, res_id),
+                    ((uint32_t)(wh >> 32) == disp_w && (uint32_t)wh == disp_h)
+                       ? " DISPLAY" : "");
          }
       }
       last_frame_res_id = (uint32_t)res_id;
@@ -316,6 +338,24 @@ vkr_remora_note_submit2(const VkCommandBufferSubmitInfo *infos, uint32_t count)
       vkr_remora_note_submit(&infos[i].commandBuffer, 1);
 }
 
+bool
+vkr_remora_display_frame(uint32_t *res_id, int *fd, uint32_t *width, uint32_t *height)
+{
+   if (!vkr_remora_enabled())
+      return false;
+   call_once(&track_once, track_init);
+   mtx_lock(&track_mutex);
+   const bool ok = disp_res_id != 0 && disp_fd >= 0;
+   if (ok) {
+      if (res_id) *res_id = disp_res_id;
+      if (fd) *fd = disp_fd;
+      if (width) *width = disp_w;
+      if (height) *height = disp_h;
+   }
+   mtx_unlock(&track_mutex);
+   return ok;
+}
+
 uint32_t
 vkr_remora_last_frame_res_id(void)
 {
diff --git a/src/venus/vkr_remora_track.h b/src/venus/vkr_remora_track.h
index f786168d..eb754e2c 100644
--- a/src/venus/vkr_remora_track.h
+++ b/src/venus/vkr_remora_track.h
@@ -75,4 +75,16 @@ void vkr_remora_note_submit2(const VkCommandBufferSubmitInfo *infos, uint32_t co
 /* Most recently submitted render target, or 0 if none seen. */
 uint32_t vkr_remora_last_frame_res_id(void);
 
+/* The most recent DISPLAY frame: its resource, dma_buf fd (not owned — dup to
+ * keep) and extent. False until a display frame has been seen.
+ *
+ * "The display" is labelled by EXTENT, once, as the largest render target: on a
+ * live session the targets are 3760x1992 (the display), 3760x234 and 3760x56
+ * (the nav and status bar layers) and assorted smaller ones, so the display is
+ * unambiguous. Labelling once rather than per frame is what the res_id chain
+ * buys — the alternative, "most recent of the right size", is a heuristic that
+ * would silently follow the wrong target. */
+bool vkr_remora_display_frame(uint32_t *res_id, int *fd, uint32_t *width,
+                              uint32_t *height);
+
 #endif /* VKR_REMORA_TRACK_H */
