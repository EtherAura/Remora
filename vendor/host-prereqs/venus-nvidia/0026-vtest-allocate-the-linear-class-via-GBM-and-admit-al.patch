+/* --- GBM-backed linear allocation (bd remora-e5x.35) ----------------------
+ *
+ * NVIDIA cannot correctly re-import a dma_buf backed by its own Vulkan
+ * host-visible SYSMEM export: the kernel fails to register the second DMA
+ * mapping (intermapRegisterDmaMapping / gpu_vaspace.c asserts) and the import
+ * reads garbage — plane 1 as zeros (the green preview), single-plane
+ * re-imports walking pages in REVERSE.  A GBM allocation on nvidia-drm is the
+ * same memory class (sysmem, CPU-mappable) through the allocator compositors
+ * exercise daily, and its re-imports are byte-perfect — measured standalone in
+ * tools/gbmchain.c, which also proves the dmabuf mmap()s (the guest is a
+ * container and maps the fd directly) and that the fd is the allocation's
+ * sole owner once the bo is destroyed.
+ *
+ * libgbm is dlopened like Vulkan above so hosts without it keep the old path;
+ * the declarations here are the handful of entry points we use, spelled out
+ * so the build does not grow a gbm.h dependency. */
+struct gbm_device;
+struct gbm_bo;
+#define REMORA_GBM_BO_USE_LINEAR (1u << 4)
+
+struct alloc_gbm {
+   void *lib;
+   int drm_fd;
+   struct gbm_device *dev;
+   struct gbm_device *(*create_device)(int fd);
+   struct gbm_bo *(*bo_create)(struct gbm_device *dev, uint32_t width,
+                               uint32_t height, uint32_t format, uint32_t flags);
+   void (*bo_destroy)(struct gbm_bo *bo);
+   uint32_t (*bo_get_stride)(struct gbm_bo *bo);
+   uint64_t (*bo_get_modifier)(struct gbm_bo *bo);
+   int (*bo_get_fd)(struct gbm_bo *bo);
+};
+
+static struct alloc_gbm alloc_gbm = { .drm_fd = -1 };
+static bool alloc_gbm_failed;
+
+/* under alloc_vk_mutex, like everything else in this file */
+static int
+alloc_gbm_init_locked(void)
+{
+   struct alloc_gbm *g = &alloc_gbm;
+
+   if (g->dev)
+      return 0;
+   if (alloc_gbm_failed)
+      return -ENODEV;
+   alloc_gbm_failed = true; /* cleared on success */
+
+   const char *env = getenv("VTEST_ALLOC_GBM");
+   if (env && *env == '0')
+      return -ENODEV;
+
+   g->lib = dlopen("libgbm.so.1", RTLD_NOW | RTLD_LOCAL);
+   if (!g->lib)
+      g->lib = dlopen("libgbm.so", RTLD_NOW | RTLD_LOCAL);
+   if (!g->lib)
+      return -ENODEV;
+#define GET_GBM(field, sym)                                                    \
+   do {                                                                        \
+      *(void **)&g->field = dlsym(g->lib, sym);                                \
+      if (!g->field)                                                           \
+         return -ENODEV;                                                       \
+   } while (0)
+   GET_GBM(create_device, "gbm_create_device");
+   GET_GBM(bo_create, "gbm_bo_create");
+   GET_GBM(bo_destroy, "gbm_bo_destroy");
+   GET_GBM(bo_get_stride, "gbm_bo_get_stride");
+   GET_GBM(bo_get_modifier, "gbm_bo_get_modifier");
+   GET_GBM(bo_get_fd, "gbm_bo_get_fd");
+#undef GET_GBM
+
+   /* the node must be the NVIDIA one — this box also has an iGPU whose mesa
+    * GBM would allocate buffers the NVIDIA driver cannot import at all */
+   const char *want_node = getenv("VTEST_ALLOC_GBM_NODE");
+   if (want_node) {
+      g->drm_fd = open(want_node, O_RDWR | O_CLOEXEC);
+   } else {
+      for (int i = 128; i < 136 && g->drm_fd < 0; i++) {
+         char node[32];
+         snprintf(node, sizeof(node), "/dev/dri/renderD%d", i);
+         int fd = open(node, O_RDWR | O_CLOEXEC);
+         if (fd < 0)
+            continue;
+         drmVersionPtr v = drmGetVersion(fd);
+         if (v && !strcmp(v->name, "nvidia-drm"))
+            g->drm_fd = fd;
+         else
+            close(fd);
+         if (v)
+            drmFreeVersion(v);
+      }
+   }
+   if (g->drm_fd < 0)
+      return -ENODEV;
+
+   g->dev = g->create_device(g->drm_fd);
+   if (!g->dev) {
+      close(g->drm_fd);
+      g->drm_fd = -1;
+      return -ENODEV;
+   }
+
+   fprintf(stderr, "vtest_gpu_alloc: linear allocations via GBM on nvidia-drm\n");
+   alloc_gbm_failed = false;
+   return 0;
+}
+
+static int
+vtest_gpu_alloc_gbm_linear(uint32_t width, uint32_t height, uint32_t drm_format,
+                           uint32_t *out_stride, uint64_t *out_modifier,
+                           uint64_t *out_size, int *out_fd)
+{
+   pthread_mutex_lock(&alloc_vk_mutex);
+
+   struct alloc_gbm *g = &alloc_gbm;
+   int ret = alloc_gbm_init_locked();
+   if (ret) {
+      pthread_mutex_unlock(&alloc_vk_mutex);
+      return ret;
+   }
+   ret = -EINVAL;
+
+   /* GBM formats ARE the DRM fourccs, so drm_format passes straight through;
+    * a format the backend refuses falls back to the Vulkan path per-call.
+    *
+    * The height-padding loop is the e5x.34 contract carried over: an
+    * importer's DEDICATED image is sized to a 128 KiB multiple where the
+    * allocation itself is sized tightly, NVIDIA requires dedicated-import
+    * size to equal the dmabuf size exactly, and the fd's length is fixed
+    * here.  The guest keeps seeing the real height and stride; the padded
+    * rows only make the exported fd long enough.  lseek is the truth about
+    * what the allocator actually exported, so the loop checks that. */
+   const uint64_t kImportAlign = 128 * 1024;
+   uint32_t padded_height = height;
+   uint32_t stride = 0;
+   int fd = -1;
+   for (int guard = 0; guard < 8; guard++) {
+      struct gbm_bo *bo =
+         g->bo_create(g->dev, width, padded_height, drm_format, REMORA_GBM_BO_USE_LINEAR);
+      if (!bo)
+         goto out;
+      stride = g->bo_get_stride(bo);
+      const uint64_t modifier = g->bo_get_modifier(bo);
+      fd = g->bo_get_fd(bo);
+      /* the fd owns the allocation from here (gbmchain-verified); the bo
+       * handle is transient, same as the VkImage in the path below */
+      g->bo_destroy(bo);
+      if (fd < 0 || !stride)
+         goto out;
+      if (modifier != 0) {
+         /* not linear after all — the whole point of this class is a layout
+          * the guest can mmap and address arithmetically */
+         goto out;
+      }
+      const off_t fd_size = lseek(fd, 0, SEEK_END);
+      if (fd_size <= 0)
+         goto out;
+      if ((uint64_t)fd_size % kImportAlign == 0) {
+         vkr_log_alloc_geometry(width, height, drm_format, stride,
+                                (uint64_t)fd_size, 0);
+         *out_stride = stride;
+         *out_modifier = 0;
+         *out_size = (uint64_t)fd_size;
+         *out_fd = fd;
+         registry_record(fd, width, height, drm_format, stride, 0,
+                         (uint64_t)fd_size);
+         ret = 0;
+         pthread_mutex_unlock(&alloc_vk_mutex);
+         return ret;
+      }
+      const uint64_t target = ALLOC_ALIGN((uint64_t)fd_size, kImportAlign);
+      padded_height += (uint32_t)((target - (uint64_t)fd_size + stride - 1) / stride);
+      close(fd);
+      fd = -1;
+   }
+
+out:
+   if (fd >= 0)
+      close(fd);
+   pthread_mutex_unlock(&alloc_vk_mutex);
+   return ret;
+}
+
 /* NOTE: before this, vtest_gpu_alloc_image() had exactly one caller and it passed
  * linear=false, so the entire linear branch was dead code the compiler stripped. */
 int
@@ -659,6 +843,40 @@
                            uint32_t *out_stride, uint64_t *out_modifier,
                            uint64_t *out_size, int *out_fd)
 {
+   /* R8 blobs go to GBM — everything else keeps the Vulkan sysmem export.
+    *
+    * The linear class serves two disjoint consumer sets, measured live (bd
+    * remora-e5x.35):
+    *  - R8 spoofed blobs are the guest gralloc's CPU-format buffers (NV12
+    *    camera frames, YV12 sw-decode, c2 bitstream blocks).  Their consumers
+    *    are the guest CPU (mmap) and the NVIDIA GPU itself — and NVIDIA's
+    *    re-import of its own Vulkan sysmem export is corrupt (reverse page
+    *    walks, YCbCr plane 1 zeros; tools/gbmchain.c), where a GBM
+    *    allocation re-imports byte-perfectly.
+    *  - Real-fourcc linear buffers (the decoder's RGBX output pool, the
+    *    encoder's direct-RGB input) are imported by the INTEL iGPU's VA
+    *    driver, and iHD refuses DRM_PRIME_2 import of an nvidia-GBM dmabuf
+    *    outright ('vaCreateSurfaces failed: resource allocation failed',
+    *    which kills every hw codec session) while it imports the Vulkan
+    *    sysmem export fine.  SF's own single-plane sampling of those is the
+    *    one sysmem re-import that behaves, so that class stays put. */
+   if (drm_format == ALLOC_DRM_FORMAT_R8) {
+      int ret = vtest_gpu_alloc_gbm_linear(width, height, drm_format, out_stride,
+                                           out_modifier, out_size, out_fd);
+      if (!ret)
+         return 0;
+      /* Loudly ONCE: on a fallen-back allocation every dedicated YCbCr import
+       * of it will read broken chroma, and that should be diagnosable here. */
+      static bool warned;
+      if (!warned) {
+         warned = true;
+         fprintf(stderr,
+                 "vtest_gpu_alloc: GBM blob allocation unavailable (%d) — falling "
+                 "back to Vulkan sysmem export, whose NVIDIA YCbCr re-imports are "
+                 "corrupt (bd remora-e5x.35)\n",
+                 ret);
+      }
+   }
    return vtest_gpu_alloc_image(width, height, drm_format, true, out_stride,
                                 out_modifier, out_size, out_fd);
 }
