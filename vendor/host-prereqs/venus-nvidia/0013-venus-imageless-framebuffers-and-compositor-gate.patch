 src/venus/vkr_render_pass.c    | 22 ++++++++
 3 files changed, 149 insertions(+), 3 deletions(-)

diff --git a/src/venus/vkr_command_buffer.c b/src/venus/vkr_command_buffer.c
index d3b4f8bf..aa2741b8 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -5,6 +5,9 @@
 
 #include "vkr_command_buffer.h"
 
+#include <stdio.h>
+#include <unistd.h>
+
 #include "vkr_remora_track.h"
 
 #include "vkr_command_buffer_gen.h"
@@ -500,11 +503,41 @@ vkr_dispatch_vkCmdPushConstants(UNUSED struct vn_dispatch_context *dispatch,
                 args->size, args->pValues);
 }
 
+
+/* The missing link for IMAGELESS framebuffers (bd remora-e5x.15). SurfaceFlinger creates its
+ * framebuffers with VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT (measured: flags=0x1, while every app
+ * context uses 0x0), so vkCreateFramebuffer carries no views and the framebuffer->view map never
+ * learns its target — fb=0 against cmdfb=398, resolved=0 forever. The view arrives HERE instead,
+ * in VkRenderPassAttachmentBeginInfo on the render-pass begin. Runs after VKR_CMD_CALL, so the
+ * handles have already been replaced with host handles — the same key space as every map.
+ * note_cmd_framebuffer stays as the non-imageless route; it only writes on a map hit, so the two
+ * cannot clobber each other. */
+static void
+vkr_remora_note_rp_attachments(VkCommandBuffer cmd, const VkRenderPassBeginInfo *info)
+{
+   if (!vkr_remora_enabled() || !info)
+      return;
+   const VkRenderPassAttachmentBeginInfo *att = NULL;
+   for (const VkBaseInStructure *p = info->pNext; p; p = p->pNext)
+      if (p->sType == VK_STRUCTURE_TYPE_RENDER_PASS_ATTACHMENT_BEGIN_INFO)
+         att = (const VkRenderPassAttachmentBeginInfo *)p;
+   if (att && att->attachmentCount && att->pAttachments) {
+      static bool logged;
+      if (!logged) {
+         logged = true;
+         fprintf(stderr, "[remora-fbinfo] pid=%d imageless attachment linked (count=%u)\n",
+                 (int)getpid(), att->attachmentCount);
+      }
+      /* Attachment 0 is the color target for every render pass ANGLE/Skia builds here. */
+      vkr_remora_note_cmd_target(cmd, att->pAttachments[0]);
+   }
+}
 static void
 vkr_dispatch_vkCmdBeginRenderPass(UNUSED struct vn_dispatch_context *dispatch,
                                   struct vn_command_vkCmdBeginRenderPass *args)
 {
    VKR_CMD_CALL(CmdBeginRenderPass, args, args->pRenderPassBegin, args->contents);
+   vkr_remora_note_rp_attachments(args->commandBuffer, args->pRenderPassBegin);
    if (vkr_remora_enabled() && args->pRenderPassBegin)
       vkr_remora_note_cmd_framebuffer(args->commandBuffer,
                                       args->pRenderPassBegin->framebuffer);
