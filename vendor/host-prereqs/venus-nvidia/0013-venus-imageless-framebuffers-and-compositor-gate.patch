@@ -736,6 +776,51 @@ vkr_remora_note_submit(struct vkr_queue *queue, const VkCommandBuffer *cmds,
 
       n_resolved++;
 
+      /* Every DISTINCT extent each guest context resolves to, logged BEFORE any display
+       * filtering. Logging inside the display branch only showed contexts that already matched
+       * the label, which is circular: it could never reveal a compositor whose target never got
+       * labelled in the first place (bd remora-e5x.15). */
+      {
+         const uint64_t _wh0 = map_get(&map_img_wh, image);
+         static uint64_t seen_extents[24];
+         static unsigned n_seen;
