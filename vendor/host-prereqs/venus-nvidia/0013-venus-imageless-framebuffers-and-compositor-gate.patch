+         bool known = false;
+         for (unsigned i = 0; i < n_seen; i++)
+            if (seen_extents[i] == _wh0)
+               known = true;
+         if (!known && n_seen < 24) {
+            seen_extents[n_seen++] = _wh0;
+            fprintf(stderr, "[remora-ctx] pid=%d context='%s' resolves %ux%u\n", (int)getpid(),
+                    cname, (uint32_t)(_wh0 >> 32), (uint32_t)_wh0);
+         }
+      }
+
+      /* ONLY THE COMPOSITOR'S FRAMES ARE DISPLAY FRAMES. The extent heuristic alone was wrong
+       * four separate ways — a dead publisher, a competing GL-pass producer, the launcher's own
+       * full-screen window (the drawer-over-black bug), and a stale label after resize — because
+       * any app can render at exactly the display's size. The context name is positive identity:
