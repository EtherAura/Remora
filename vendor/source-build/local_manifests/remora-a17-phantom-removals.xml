<?xml version="1.0" encoding="UTF-8"?>
<!-- A17: LineageOS-24 manifest projects that have no lineage-24.0 branch upstream
     (leaf apps/tools/device HALs) so they never sync. this product needs none of them.
     Removed so "repo manifest -r" (build-manifest.xml generation) does not rev-parse a
     nonexistent checkout and abort. -->
