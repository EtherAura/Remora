From f8aa037d80d198c2cab450de46595d5eac2bfd8b Mon Sep 17 00:00:00 2001
From: Remora <remora@localhost>
Date: Tue, 24 Nov 2026 09:55:33 -0500
Subject: [PATCH] A17 LineageParts: Trust's alert switches start off

TrustPreferences read trust_warnings with every warning on as the
default. The lineage-sdk TrustInterfaceService patch makes unset mean
no warnings, because a container fails both checks (SELinux, test keys)
by construction. Read the same default here, so the Alerts switches
show what the service does, and turning one on writes only that bit.

Change-Id: I9d0ef4e503f2595a124cf76c0a91770d5bd36c9c
---
 src/org/lineageos/lineageparts/trust/TrustPreferences.java | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/org/lineageos/lineageparts/trust/TrustPreferences.java b/src/org/lineageos/lineageparts/trust/TrustPreferences.java
index c76357c..c3019a3 100644
--- a/src/org/lineageos/lineageparts/trust/TrustPreferences.java
+++ b/src/org/lineageos/lineageparts/trust/TrustPreferences.java
@@ -93,8 +93,10 @@ public class TrustPreferences extends SettingsPreferenceFragment {
         setupSecurityPatches(secPLevel, secVLevel);
         setupEncryption(encryptLevel);
 
+        // Remora: unset means no warnings, as in TrustInterfaceService (a container fails both
+        // checks by construction).
         int currentFeatures = LineageSettings.Secure.getInt(getContext().getContentResolver(),
-                LineageSettings.Secure.TRUST_WARNINGS, TrustInterface.TRUST_WARN_MAX_VALUE);
+                LineageSettings.Secure.TRUST_WARNINGS, 0);
         mWarnSELinuxPref.setChecked((currentFeatures & TrustInterface.TRUST_WARN_SELINUX) != 0);
         mWarnKeysPref.setChecked((currentFeatures & TrustInterface.TRUST_WARN_PUBLIC_KEY) != 0);
 
@@ -212,7 +214,7 @@ public class TrustPreferences extends SettingsPreferenceFragment {
 
     private boolean onWarningChanged(Boolean value, int feature) {
         int original = LineageSettings.Secure.getInt(requireContext().getContentResolver(),
-                LineageSettings.Secure.TRUST_WARNINGS, TrustInterface.TRUST_WARN_MAX_VALUE);
+                LineageSettings.Secure.TRUST_WARNINGS, 0);
         int newValue = value ? (original | feature) : (original & ~feature);
         boolean success = LineageSettings.Secure.putInt(requireContext().getContentResolver(),
                 LineageSettings.Secure.TRUST_WARNINGS,
-- 
