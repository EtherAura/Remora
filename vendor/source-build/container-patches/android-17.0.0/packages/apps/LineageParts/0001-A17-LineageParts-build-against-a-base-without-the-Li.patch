@@ -119,7 +123,7 @@ public class DisplayRotation extends SettingsPreferenceFragment {
                 mRotation0Pref.setChecked(true);
             }
             Settings.System.putIntForUser(requireActivity().getContentResolver(),
-                    Settings.System.ACCELEROMETER_ROTATION_ANGLES, mode, UserHandle.USER_CURRENT);
+                    ACCELEROMETER_ROTATION_ANGLES, mode, UserHandle.USER_CURRENT);
             return true;
         }
 
