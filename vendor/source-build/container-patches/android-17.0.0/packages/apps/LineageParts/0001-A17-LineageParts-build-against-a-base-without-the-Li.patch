diff --git a/src/org/lineageos/lineageparts/profiles/SetupActionsFragment.java b/src/org/lineageos/lineageparts/profiles/SetupActionsFragment.java
index 17196fc..49ce7ff 100644
--- a/src/org/lineageos/lineageparts/profiles/SetupActionsFragment.java
+++ b/src/org/lineageos/lineageparts/profiles/SetupActionsFragment.java
@@ -88,6 +88,21 @@ public class SetupActionsFragment extends SettingsPreferenceFragment
 
     private static final int NEW_TRIGGER_REQUEST_CODE = 1001;
 
+    // DevicePolicyManager.requireSecureKeyguard() in the LineageOS framework, which the Android
+    // 17 base this image builds on does not have. The same three tests, from public calls.
+    private static boolean requireSecureKeyguard(DevicePolicyManager dpm) {
+        if (dpm.getPasswordQuality(null) > DevicePolicyManager.PASSWORD_QUALITY_UNSPECIFIED) {
+            return true;
+        }
+        final int encryption = dpm.getStorageEncryptionStatus();
+        if (encryption == DevicePolicyManager.ENCRYPTION_STATUS_ACTIVE
+                || encryption == DevicePolicyManager.ENCRYPTION_STATUS_ACTIVATING) {
+            return true;
+        }
+        return (dpm.getKeyguardDisabledFeatures(null)
+                & DevicePolicyManager.KEYGUARD_DISABLE_TRUST_AGENTS) != 0;
+    }
+
     private static final int MENU_REMOVE = Menu.FIRST;
     private static final int MENU_FILL_PROFILE = Menu.FIRST + 1;
 
@@ -222,7 +237,7 @@ public class SetupActionsFragment extends SettingsPreferenceFragment
         mItems.add(new RingModeItem(mProfile.getRingMode()));
         mItems.add(new AirplaneModeItem(mProfile.getAirplaneMode()));
         DevicePolicyManager dpm = context.getSystemService(DevicePolicyManager.class);
-        if (!dpm.requireSecureKeyguard()) {
+        if (!requireSecureKeyguard(dpm)) {
             mItems.add(new LockModeItem(mProfile));
         } else {
             mItems.add(new DisabledItem(R.string.profile_lockmode_title,
