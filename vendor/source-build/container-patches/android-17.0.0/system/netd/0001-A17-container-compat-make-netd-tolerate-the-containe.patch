From 580879a6ce125f9a547b5defebef92e733426bc6 Mon Sep 17 00:00:00 2001
From: Remora <noreply@localhost>
Date: Tue, 21 Jul 2026 18:51:48 -0400
Subject: [PATCH] A17 container-compat: make netd tolerate the container's
 iptables/BPF limits
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The container runs netd's iptables-legacy on a stock kernel that lacks Android's
netfilter modules (xt_quota2, per-network mark, some legacy tables). Left as-is,
netd exits or aborts network setup, and the ethernet NetworkAgent never gets its
routes -> eth0 has no default route -> no adb/network. Mirrors the A16 container-compat
netd fix:
- IptablesRestoreController::execute: ignore iptables errors (res=0) — the key
  one; lets networkAddInterface's incoming-mark rule succeed so eth0 routes land.
- Controllers::init: iptables + bandwidth-control init non-fatal (no exit).
- BandwidthController::updateQuota: non-fatal.
- TetherController::getTetherStats: skip unreadable targets, return empty stats
  (stops NetworkStatsService throwing during systemReady, which aborted the
  ethernet NetworkAgent registration).
- main.cpp: libnetd_updatable_init non-fatal.

Pairs with loading the legacy iptables kernel modules on the guest
(kvm-guest-guest-setup.sh) so the rules actually apply where the kernel allows.

Change-Id: I3d377383c3b64ec8489ed21af31fd3165e0b68f6
---
 server/BandwidthController.cpp       |  1 +
 server/Controllers.cpp               | 14 ++++++++++++--
 server/IptablesRestoreController.cpp |  7 +++++++
 server/TetherController.cpp          | 11 ++++++++---
 server/main.cpp                      |  3 ++-
 5 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/server/BandwidthController.cpp b/server/BandwidthController.cpp
index 8a96738..7df76f1 100644
--- a/server/BandwidthController.cpp
+++ b/server/BandwidthController.cpp
@@ -527,6 +527,7 @@ int BandwidthController::updateQuota(const std::string& quotaName, int64_t bytes
     if (!isOk(file)) {
         int res = errno;
         ALOGE("Updating quota %s failed (%s)", quotaName.c_str(), toString(file).c_str());
+        res = 0;  // A17: bandwidth quota fs isn't writable in the container — non-fatal
         return -res;
     }
     // TODO: should we propagate this error?
diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index 8a2c3be..c035abe 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -324,18 +324,28 @@ int Controllers::initIptablesRules() {
 void Controllers::init() {
     if (initIptablesRules()) {
         gLog.error("Failed to initialize iptables rules");
-        exit(1);
+        // A17: the container's network namespace has only nf_tables loaded on the host
+        // kernel, not the legacy ip6table_mangle/nat tables that netd's static iptables-legacy
+        // ruleset requires ("ip6tables-restore: unable to initialize table 'mangle'"). The original
+        // code exit(1)s here, which crash-loops netd forever; system_server then blocks in
+        // NetworkManagementService waiting for netd and boot_completed never fires. netd's binder
+        // interface must still come up, so tolerate the failure. Firewall/accounting rules are
+        // degraded; basic networking over the container's macvlan/host path is unaffected.
+        // exit(1);
     }
     Stopwatch s;
 
     if (int ret = bandwidthCtrl.enableBandwidthControl()) {
         gLog.error("Failed to initialize BandwidthController (%s)", strerror(-ret));
+        // A17: same container iptables limitation as initIptablesRules() above — the static
+        // bandwidth ruleset can't load without legacy iptables tables. Upstream exit(2)s here
+        // (comment below), which crash-loops netd and blocks boot. Tolerate it so netd stays up.
         // A failure to init almost definitely means that iptables failed to load
         // our static ruleset, which then basically means network accounting will not work.
         // As such simply exit netd.  This may crash loop the system, but by failing
         // to bootup we will trigger rollback and thus this offers us protection against
         // a mainline update breaking things.
-        exit(2);
+        // exit(2);
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
diff --git a/server/IptablesRestoreController.cpp b/server/IptablesRestoreController.cpp
index 49b48d3..263094f 100644
--- a/server/IptablesRestoreController.cpp
+++ b/server/IptablesRestoreController.cpp
@@ -349,6 +349,13 @@ int IptablesRestoreController::execute(const IptablesTarget target, const std::s
     if (target == V6 || target == V4V6) {
         res |= sendCommand(IP6TABLES_PROCESS, command, output);
     }
+    // A17: the container runs on a stock kernel that lacks Android's netfilter modules
+    // (xt_quota2, the per-network mark/BPF paths, some legacy tables), so many netd iptables commands
+    // fail. Returning that failure aborts networkAddInterface (the incoming-packet-mark rule) ->
+    // eth0 never joins the network -> no route -> no adb. Ignore the iptables error so netd's network
+    // setup completes; firewall/accounting is degraded but basic routing (the goal) works. This
+    // matches the A16 container-compat netd fix.
+    res = 0;  // ignore iptables error
     return res;
 }
 
diff --git a/server/TetherController.cpp b/server/TetherController.cpp
index b159d95..36fa26e 100644
--- a/server/TetherController.cpp
+++ b/server/TetherController.cpp
@@ -907,9 +907,14 @@ StatusOr<TetherController::TetherStatsList> TetherController::getTetherStats() {
 
     for (const IptablesTarget target : {V4, V6}) {
         std::string statsString;
-        if (int ret = iptablesRestoreFunction(target, GET_TETHER_STATS_COMMAND, &statsString)) {
-            return statusFromErrno(-ret, StringPrintf("failed to fetch tether stats (%d): %d",
-                                                      target, ret));
+        if (iptablesRestoreFunction(target, GET_TETHER_STATS_COMMAND, &statsString)) {
+            // A17: the container has only nf_tables loaded, so reading the legacy iptables
+            // tether-stats chain fails with EPERM. Returning an error makes NetworkStatsService
+            // .bootstrapStatsLocked() throw during systemReady, which then aborts ConnectivityService
+            // 's ethernet NetworkAgent registration -> eth0 never enters the framework -> no default
+            // route -> no adb/network reachability. Tethering is unused in the container; skip the
+            // unreadable target and return whatever stats we have (empty) instead of failing.
+            continue;
         }
 
         if (int ret = addForwardChainStats(statsList, statsString, parsedIptablesOutput)) {
diff --git a/server/main.cpp b/server/main.cpp
index be9a1d0..45bcb7e 100644
--- a/server/main.cpp
+++ b/server/main.cpp
@@ -147,7 +147,8 @@ int main(const int argc, const char* argv[]) {
 
     if (libnetd_updatable_init(cg2_path.c_str())) {
         ALOGE("libnetd_updatable_init failed");
-        exit(1);
+        // A17: libnetd_updatable (the BPF/cgroup network layer) can't fully init in the
+        // container; don't exit — the rest of netd still brings up basic routing. Matches A16.
     }
     gLog.info("libnetd_updatable_init success");
 
-- 
2.54.0

