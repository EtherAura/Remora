     if (mPendingColorAspectsChange &&
diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index 53689bd..f20f3b2 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -264,6 +264,22 @@ DecodeInterface::DecodeInterface(const std::string& name,
                          .withConstValue(
                                  new C2StreamBufferTypeSetting::output(0u, C2BufferData::GRAPHIC))
                          .build());
+
+    // C2MemoryUsage::CPU_READ is included so gralloc allocates the decoder's OUTPUT buffers
+    // LINEAR: minigbm (cros_gralloc, androidboot.remora_gralloc=minigbm_intel) would otherwise
+    // pick an Intel-tiled modifier for a no-SW-usage video target, which SurfaceFlinger's Skia
+    // render engine silently fails to sample on the xe SR-IOV VF — the video layer keeps flipping
+    // (frame counter advances at 30fps) but composition shows a stale texture: playing audio,
+    // frozen frame. Same bit-space caveat as the encoder input fix: this is C2MemoryUsage, NOT
+    // android BufferUsage (CPU_READ_OFTEN here would set READ_PROTECTED and abort SF's Skia
+    // texture creation).
+    addParameter(
+            DefineParam(mOutputMemoryUsage, C2_PARAMKEY_OUTPUT_STREAM_USAGE)
+                    .withConstValue(new C2StreamUsageTuning::output(
+                            0u, static_cast<uint64_t>(android::hardware::graphics::common::V1_0::
+                                                              BufferUsage::VIDEO_DECODER) |
+                                        static_cast<uint64_t>(C2MemoryUsage::CPU_READ)))
+                    .build());
     addParameter(
