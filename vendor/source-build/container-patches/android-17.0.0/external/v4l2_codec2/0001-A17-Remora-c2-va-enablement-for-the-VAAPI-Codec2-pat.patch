 #include <log/log.h>
 #include <media/stagefright/MediaDefs.h>
 #include <ui/GraphicBuffer.h>
@@ -185,6 +186,8 @@ EncodeComponent::EncodeComponent(C2String name, c2_node_id_t id,
         mInterface(std::move(interface)),
         mComponentState(ComponentState::LOADED) {
     ALOGV("%s(%s)", __func__, name.c_str());
+    // Ops-side fallback for the max-fps cap when the client doesn't set the vendor param.
+    mPropMaxFps = property_get_int32("vendor.remora.encoder_max_fps", 0);
 }
 
 EncodeComponent::~EncodeComponent() {
@@ -453,6 +456,35 @@ void EncodeComponent::queueTask(std::unique_ptr<C2Work> work) {
         return;
     }
 
+    // Component-side max-fps frame dropping (bd remora-rjh). Nothing else drops on this stack:
+    // the SDK's KEY_MAX_FPS_TO_ENCODER only configures the framework's InputSurface, so any SF
+    // render rate above the encoder drain rate backs the mirror BufferQueue up and the
+    // backpressure stalls SurfaceFlinger globally. The cap arrives via the vendor tuning
+    // ("vendor.remora-max-fps.value", per session) or the vendor.remora.encoder_max_fps
+    // property (ops fallback). A dropped work completes immediately with no output — the same
+    // contract as the empty-CSD discard above. Never dropped: the first frame (carries
+    // CSD/IDR), EOS, non-monotonic timestamps, and frames with a sync-frame request pending
+    // (the request is only consumed on the encode path).
+    if (!work->input.buffers.empty() && !endOfStream && mDropLastTsUs &&
+        timestamp > *mDropLastTsUs) {
+        int32_t maxFps = mInterface->getRemoraMaxFps();
+        if (maxFps <= 0) maxFps = mPropMaxFps;
+        if (maxFps > 0 && (timestamp - *mDropLastTsUs) <
+                                  static_cast<int64_t>(950000) / maxFps /* 5% vsync slack */) {
+            C2StreamRequestSyncFrameTuning::output requestKeyFrame;
+            const bool syncPending =
+                    (mInterface->query({&requestKeyFrame}, {}, C2_DONT_BLOCK, nullptr) == C2_OK) &&
+                    requestKeyFrame.value == C2_TRUE;
+            if (!syncPending) {
+                ALOGV("Dropping frame ts=%" PRId64 " (max-fps %d, gap %" PRId64 "us)", timestamp,
+                      maxFps, timestamp - *mDropLastTsUs);
+                reportWork(std::move(work));
+                return;
+            }
+        }
+    }
+    mDropLastTsUs = timestamp;
+
     // By the time we get an input buffer, the output block pool should be configured.
     if (!mOutputBlockPool && !getBlockPool()) {
         reportError(C2_CORRUPTED);
@@ -469,7 +501,7 @@ void EncodeComponent::queueTask(std::unique_ptr<C2Work> work) {
             reportError(C2_CORRUPTED);
             return;
         }
-        if (mEncoder->inputFormat() != format) {
+        if (mEncoder->inputFormat() != format && !mEncoder->handlesInputFormatConversion()) {
             ALOG_ASSERT(!mInputFormatConverter);
             ALOGV("Creating input format convertor (%s)",
                   videoPixelFormatToString(mEncoder->inputFormat()).c_str());
@@ -623,6 +655,9 @@ void EncodeComponent::flushTask(::base::WaitableEvent* done,
     }
     done->Signal();
 
+    // Post-flush the next frame must always encode (fresh IDR/CSD), so forget the drop cadence.
+    mDropLastTsUs.reset();
+
     flush();
 }
 
