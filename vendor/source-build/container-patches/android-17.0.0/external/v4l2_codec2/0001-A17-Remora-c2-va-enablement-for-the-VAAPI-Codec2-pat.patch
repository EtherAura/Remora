+constexpr uint32_t kParamIndexRemoraMaxFps = C2Param::TYPE_INDEX_VENDOR_START + 0xF5;
+typedef C2StreamParam<C2Tuning, C2Int32Value, kParamIndexRemoraMaxFps> C2StreamRemoraMaxFpsTuning;
+constexpr char C2_PARAMKEY_REMORA_MAX_FPS[] = "remora-max-fps";
