diff --git a/common/EncodeHelpers.cpp b/common/EncodeHelpers.cpp
index c1a9425..2e64876 100644
--- a/common/EncodeHelpers.cpp
+++ b/common/EncodeHelpers.cpp
@@ -15,6 +15,7 @@
 #include <utils/Log.h>
 
 #include <v4l2_codec2/common/H264NalParser.h>
+#include <v4l2_codec2/common/HEVCNalParser.h>
 
 namespace android {
 
@@ -132,23 +133,58 @@ bool extractSPSPPS(const uint8_t* data, size_t length, std::vector<uint8_t>* sps
     return foundSPS && foundPPS;
 }
 
+// HEVC codec config = VPS(32) + SPS(33) + PPS(34).
+static bool extractHEVCParamSets(const uint8_t* data, size_t length, std::vector<uint8_t>* vps,
+                                 std::vector<uint8_t>* sps, std::vector<uint8_t>* pps) {
+    bool foundVPS = false, foundSPS = false, foundPPS = false;
+    HEVCNalParser parser(data, length);
+    while (!(foundVPS && foundSPS && foundPPS) && parser.locateNextNal()) {
+        switch (parser.type()) {
+        case 32:  // VPS_NUT
+            vps->assign(parser.data(), parser.data() + parser.length());
+            foundVPS = true;
+            break;
+        case HEVCNalParser::kSPSType:  // 33
+            sps->assign(parser.data(), parser.data() + parser.length());
+            foundSPS = true;
+            break;
+        case 34:  // PPS_NUT
+            pps->assign(parser.data(), parser.data() + parser.length());
+            foundPPS = true;
+            break;
+        }
+    }
+    return foundSPS && foundPPS;  // VPS is normally present too but SPS+PPS are the minimum
+}
+
 bool extractCSDInfo(std::unique_ptr<C2StreamInitDataInfo::output>* const csd, const uint8_t* data,
                     size_t length) {
     csd->reset();
 
     std::vector<uint8_t> sps;
     std::vector<uint8_t> pps;
-    if (!extractSPSPPS(data, length, &sps, &pps)) {
-        return false;
+    if (extractSPSPPS(data, length, &sps, &pps)) {
+        size_t configDataLength = sps.size() + pps.size() + (2u * kH264StartCodeSize);
+        ALOGV("Extracted H264 codec config data: length=%zu", configDataLength);
+        *csd = C2StreamInitDataInfo::output::AllocUnique(configDataLength, 0u);
+        uint8_t* csdBuffer = (*csd)->m.value;
+        return copyNALUPrependingStartCode(sps.data(), sps.size(), &csdBuffer, &configDataLength) &&
+               copyNALUPrependingStartCode(pps.data(), pps.size(), &csdBuffer, &configDataLength);
     }
 
-    size_t configDataLength = sps.size() + pps.size() + (2u * kH264StartCodeSize);
-    ALOGV("Extracted codec config data: length=%zu", configDataLength);
-
-    *csd = C2StreamInitDataInfo::output::AllocUnique(configDataLength, 0u);
-    uint8_t* csdBuffer = (*csd)->m.value;
-    return copyNALUPrependingStartCode(sps.data(), sps.size(), &csdBuffer, &configDataLength) &&
-           copyNALUPrependingStartCode(pps.data(), pps.size(), &csdBuffer, &configDataLength);
+    // No H264 SPS/PPS → try HEVC (VPS+SPS+PPS).
+    std::vector<uint8_t> vps;
+    if (extractHEVCParamSets(data, length, &vps, &sps, &pps)) {
+        size_t configDataLength =
+                vps.size() + sps.size() + pps.size() + (3u * kH264StartCodeSize);
+        ALOGV("Extracted HEVC codec config data: length=%zu", configDataLength);
+        *csd = C2StreamInitDataInfo::output::AllocUnique(configDataLength, 0u);
+        uint8_t* csdBuffer = (*csd)->m.value;
+        return copyNALUPrependingStartCode(vps.data(), vps.size(), &csdBuffer, &configDataLength) &&
+               copyNALUPrependingStartCode(sps.data(), sps.size(), &csdBuffer, &configDataLength) &&
+               copyNALUPrependingStartCode(pps.data(), pps.size(), &csdBuffer, &configDataLength);
+    }
+    return false;
 }
 
 size_t prependSPSPPSToIDR(const uint8_t* src, size_t srcSize, uint8_t* dst, size_t dstSize,
