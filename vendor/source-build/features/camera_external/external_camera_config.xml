<!-- Config for AOSP's external (UVC/V4L2) camera provider — read from
     /vendor/etc/external_camera_config.xml at ExternalCameraConfig::kDefaultCfgPath.

     Depth is disabled: a UVC webcam has none, and advertising it makes apps probe for streams the
     HAL cannot supply. The size cap keeps buffer allocation bounded in a container where memory is
     already contended; raise it if a higher-resolution camera is shared. -->
<ExternalCamera>
    <Provider>
        <ignore>
            <!-- Nodes the provider must NOT claim. A UVC camera typically exposes a second,
                 metadata-only node that cannot stream; leaving it claimable produces a camera that
                 opens and then fails. Entries are the numeric suffix of /dev/video<N>. -->
        </ignore>
    </Provider>
    <Device>
        <MaxJpegBufferSize bytes="3145728"/>
        <NumVideoBuffers count="4"/>
        <NumStillBuffers count="2"/>
        <FpsList>
            <Limit width="640" height="480" fpsBound="30.0"/>
            <Limit width="1280" height="720" fpsBound="30.0"/>
            <Limit width="1920" height="1080" fpsBound="30.0"/>
        </FpsList>
    </Device>
</ExternalCamera>
