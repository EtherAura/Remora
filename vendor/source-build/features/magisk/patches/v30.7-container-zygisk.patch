+// The container fallback is limited to platforms without peer security labels.
+pub(crate) fn allowed(root: bool, peer_sec_unsupported: bool, selinux_present: bool,
+                      trusted_executable: bool) -> bool {
+    root && peer_sec_unsupported && !selinux_present && trusted_executable
+}
+
+#[cfg(test)]
+mod tests {
+    use super::allowed;
+    #[test]
+    fn only_root_platform_zygotes_without_selinux_are_accepted() {
+        assert!(allowed(true, true, false, true));
+        assert!(!allowed(false, true, false, true), "application and shell UIDs stay denied");
+        assert!(!allowed(true, true, false, false), "root shells are not zygote clients");
+        assert!(!allowed(true, false, false, true), "other peer-security failures are not a fallback");
+        assert!(!allowed(true, true, true, true), "a mounted SELinux policy keeps label authentication");
+    }
+}
