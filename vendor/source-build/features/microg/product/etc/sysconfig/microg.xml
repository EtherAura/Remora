<?xml version="1.0" encoding="utf-8"?>
<!-- microG system configuration: keep GmsCore alive through power management (it carries the
     FCM push connection — the whole point of shipping it) and pin both microG packages as
     unremovable system apps. -->
<config>
    <allow-in-power-save package="com.google.android.gms"/>
    <allow-in-data-usage-save package="com.google.android.gms"/>
    <allow-unthrottled-location package="com.google.android.gms"/>
    <allow-ignore-location-settings package="com.google.android.gms"/>
    <hidden-api-whitelisted-app package="com.google.android.gms"/>
</config>
