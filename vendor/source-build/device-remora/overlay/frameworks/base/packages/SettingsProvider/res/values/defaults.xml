<?xml version="1.0" encoding="utf-8"?>
<!-- Settings defaults for remora_x86_64 (bd remora-28ix.4 R1): a mirrored container
     device should neither chirp, nor lock, nor blank itself. -->
<resources>
    <!-- UI touch sounds through a mirror are noise, twice. -->
    <bool name="def_sound_effects_enabled">false</bool>

    <bool name="def_lockscreen_disabled">true</bool>

    <!-- INT_MAX ms (~596 h): the host decides when the display sleeps (auto_sleep_minutes
         / docker pause), never the guest's own screen timeout racing it. -->
    <integer name="def_screen_off_timeout">2147483647</integer>

    <!-- Sideloaded APKs are the delivery path for half the feature set; the verifier
         would nag on every one. -->
    <bool name="def_package_verifier_enable">false</bool>
</resources>
