#
# Extended (x86_64) seccomp policy for the VAAPI Codec2 decode HAL.
#
# This is loaded as the "extended" policy on top of the base c2 policy
# (android.hardware.media.c2-default-seccomp_policy) by service.cpp via
# SetUpMinijail(base, ext). It is copied to
#   /vendor/etc/seccomp_policy/android.hardware.media.c2@1.2-service-vaapi-seccomp_policy
# by va.mk. It ONLY adds the syscalls libva + libdrm + the iHD driver need on
# top of the base policy; it must NOT be used as a standalone/base policy and it
# does NOT touch the mediaswcodec policy (device/remora's mediacodec.policy.x86, installed
# under both codec names — bd remora-28ix.4).

# libdrm / libva issue DRM ioctls on the render node (vaGetDisplayDRM,
# vaExportSurfaceHandle DRM_PRIME, buffer submission).
ioctl: 1

# VA buffer mapping and surface/dmabuf memory management.
mmap: 1
munmap: 1
mremap: 1
mprotect: 1
madvise: 1

# libva worker threads and event waiting.
poll: 1
ppoll: 1
epoll_create1: 1
epoll_ctl: 1
epoll_wait: 1
epoll_pwait: 1
eventfd2: 1
futex: 1

# Driver .so / DRM node / dmabuf fd handling.
openat: 1
close: 1
fstat: 1
newfstatat: 1
getrandom: 1
