+static void stop_encode_worker(struct vrend_video_codec *cdc)
+{
+    struct encode_worker *w = cdc->worker;
+    if (!w)
+        return;
+    struct vrend_video_codec **link = &encode_workers;
+    while (*link && *link != cdc)
+        link = &(*link)->worker->next_codec;
+    if (*link)
+        *link = w->next_codec;
+    if (w->thread) {
+        EnterCriticalSection(&w->queue_lock);
+        w->stopping = true;
+        WakeConditionVariable(&w->work);
+        LeaveCriticalSection(&w->queue_lock);
+        WaitForSingleObject(w->thread, INFINITE);
+        CloseHandle(w->thread);
+    }
+    if (w->ready)
+        CloseHandle(w->ready);
+    for (unsigned i = 0; i < VIRGL_AMF_QUEUE_DEPTH; i++) {
+        struct vrend_video_encode_job *job = &cdc->pending[i];
+        if (job->done) {
+            CloseHandle(job->done);
+            job->done = NULL;
+        }
+        if (job->fence)
+            glDeleteSync(job->fence);
+        if (job->pack.name)
+            glDeleteBuffers(1, &job->pack.name);
+    }
+    DeleteCriticalSection(&w->queue_lock);
+    free(w);
+    cdc->worker = NULL;
