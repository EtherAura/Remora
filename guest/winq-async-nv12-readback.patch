+static void dispatch_uploads(struct encode_worker *w, struct vrend_video_encode_job *required)
+{
+    while (w->gpu_head) {
+        struct vrend_video_encode_job *job = w->gpu_head;
+        GLenum status = glClientWaitSync(job->fence, 0, required ? UINT64_C(3000000000) : 0);
+        if (status == GL_TIMEOUT_EXPIRED && !required)
+            break;
+        w->gpu_head = job->next;
+        if (!w->gpu_head)
+            w->gpu_tail = NULL;
+        if (job == required)
+            required = NULL;
+        glDeleteSync(job->fence);
+        job->fence = NULL;
+        if (status != GL_ALREADY_SIGNALED && status != GL_CONDITION_SATISFIED) {
+            job->submitted_ok = false;
+            SetEvent(job->done);
