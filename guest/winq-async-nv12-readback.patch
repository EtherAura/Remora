+/* The render thread owns the guest resources. The worker sees only a snapshot
+ * in a slot-owned GL buffer and a private copy of the picture descriptor. */
+static DWORD WINAPI encode_worker_main(void *arg)
+{
+    struct vrend_video_codec *cdc = arg;
+    struct encode_worker *w = cdc->worker;
+    HRESULT com = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    w->initialized = SUCCEEDED(com);
+    SetEvent(w->ready);
+
+    if (w->initialized) {
+        for (;;) {
+            EnterCriticalSection(&w->queue_lock);
+            while (!w->head && !w->stopping)
+                SleepConditionVariableCS(&w->work, &w->queue_lock, INFINITE);
+            struct vrend_video_encode_job *job = w->head;
+            if (job) {
+                w->head = job->next;
+                if (!w->head)
+                    w->tail = NULL;
+            }
+            LeaveCriticalSection(&w->queue_lock);
+            if (!job)
+                break;
+
+            job->submitted_ok = !virgl_video_amf_submit_pixels(cdc->codec,
+                job->pack.mapped, job->width, job->height,
+                &w->descriptors[job - cdc->pending], &job->ticket);
+            SetEvent(job->done);
+        }
+    }
+    if (SUCCEEDED(com))
+        CoUninitialize();
+    return 0;
