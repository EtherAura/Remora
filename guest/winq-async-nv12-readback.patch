+        return;
+    struct encode_worker *w = calloc(1, sizeof(*w));
+    if (!w)
+        return;
+    cdc->worker = w;
+    InitializeCriticalSection(&w->queue_lock);
+    InitializeConditionVariable(&w->work);
+    w->ready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!w->ready)
+        goto fail;
+    for (unsigned i = 0; i < VIRGL_AMF_QUEUE_DEPTH; i++) {
+        cdc->pending[i].done = CreateEventW(NULL, TRUE, TRUE, NULL);
+        if (!cdc->pending[i].done)
