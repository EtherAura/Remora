+/* The RX 550 WGL driver changes the calling thread's CPU affinity during
+ * context setup. In WINQ this thread also dispatches virtio requests. */
+static GROUP_AFFINITY WIN_GL_SaveAffinity(void)
+{
+    GROUP_AFFINITY saved = { 0 };
+    const char *enabled = SDL_getenv("WINQ_PRESERVE_WGL_AFFINITY");
+    if (enabled && SDL_strcmp(enabled, "1") == 0 && GetActiveProcessorGroupCount() == 1) {
+        GetThreadGroupAffinity(GetCurrentThread(), &saved);
+    }
+    return saved;
+}
+
+static void WIN_GL_RestoreAffinity(const GROUP_AFFINITY *saved)
+{
+    GROUP_AFFINITY current;
+    if (saved->Mask && GetThreadGroupAffinity(GetCurrentThread(), &current) &&
+        current.Group == saved->Group && current.Mask != saved->Mask) {
+        SetThreadGroupAffinity(GetCurrentThread(), saved, NULL);
+    }
+}
