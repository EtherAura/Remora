+static void encoder_wait_amf(struct virgl_video_codec *codec)
+{
+    const int64_t started = amf_now();
+    LARGE_INTEGER due = { .QuadPart = -10000 };
+    if (!codec->amf_wait_timer ||
+        !SetWaitableTimer(codec->amf_wait_timer, &due, 0, NULL, NULL, FALSE) ||
+        WaitForSingleObject(codec->amf_wait_timer, 50) != WAIT_OBJECT_0)
+        Sleep(1);
+    const int64_t waited = amf_now() - started;
+    codec->amf_profile.wait += waited;
+    if (waited > codec->amf_profile.max_wait)
+        codec->amf_profile.max_wait = waited;
+    codec->amf_profile.waits++;
+}
+
+static void encoder_close_amf(struct virgl_video_codec *codec)
+{
+    encoder_log_amf_profile(codec, "close");
+    memset(&codec->amf_profile, 0, sizeof(codec->amf_profile));
+    if (codec->amf_wait_timer) {
+        CloseHandle(codec->amf_wait_timer);
+        codec->amf_wait_timer = NULL;
+    }
+    for (unsigned i = 0; i < VIRGL_AMF_QUEUE_DEPTH; i++) {
+        if (codec->amf_pending[i].output)
+            codec->amf_pending[i].output->pVtbl->Release(codec->amf_pending[i].output);
+        codec->amf_pending[i].output = NULL;
+        codec->amf_pending[i].active = false;
+    }
+    codec->amf_in_flight = 0;
+    if (codec->encoder_amf) {
+        codec->encoder_amf->pVtbl->Terminate(codec->encoder_amf);
+        codec->encoder_amf->pVtbl->Release(codec->encoder_amf);
+        codec->encoder_amf = NULL;
+    }
+    if (codec->amf_upload_texture) {
+        ID3D11Texture2D_Release(codec->amf_upload_texture);
+        codec->amf_upload_texture = NULL;
+    }
+    if (codec->encoder_amf_context) {
+        codec->encoder_amf_context->pVtbl->Terminate(codec->encoder_amf_context);
+        codec->encoder_amf_context->pVtbl->Release(codec->encoder_amf_context);
+        codec->encoder_amf_context = NULL;
+    }
+    if (codec->encoder_amf_dll) {
+        FreeLibrary(codec->encoder_amf_dll);
+        codec->encoder_amf_dll = NULL;
+    }
+}
+
+static HRESULT encoder_open_amf(struct virgl_video_codec *codec)
+{
+    AMFFactory *factory = NULL;
+    amf_uint64 version = 0;
+    const wchar_t *component = IsEqualGUID(&codec->encoder_output_guid, &VIRGL_MFVIDEOFORMAT_HEVC) ?
+                              AMFVideoEncoder_HEVC : AMFVideoEncoderVCE_AVC;
+    codec->encoder_amf_dll = LoadLibraryExW(AMF_DLL_NAME, NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!codec->encoder_amf_dll)
+        return HRESULT_FROM_WIN32(GetLastError());
+
+    codec->amf_dx11_upload = getenv("WINQ_TEST_AMF_DX11_UPLOAD") &&
+                            getenv("WINQ_TEST_AMF_REQUIRE_AMD");
+    if (codec->amf_dx11_upload)
+        virgl_info("AMF input uses D3D11 NV12 upload on the selected device\n");
+    AMFInit_Fn init = (AMFInit_Fn)GetProcAddress(codec->encoder_amf_dll, AMF_INIT_FUNCTION_NAME);
+    AMFQueryVersion_Fn query = (AMFQueryVersion_Fn)GetProcAddress(codec->encoder_amf_dll, AMF_QUERY_VERSION_FUNCTION_NAME);
+    AMF_RESULT result = !init || !query ? AMF_FAIL : query(&version);
+    if (result == AMF_OK)
+        result = init(version < AMF_FULL_VERSION ? version : AMF_FULL_VERSION, &factory);
+    if (result == AMF_OK)
+        result = factory->pVtbl->CreateContext(factory, &codec->encoder_amf_context);
+    if (result == AMF_OK)
+        result = codec->encoder_amf_context->pVtbl->InitDX11(
+            codec->encoder_amf_context,
+            getenv("WINQ_TEST_AMF_REQUIRE_AMD") ? g_vid.device : NULL, AMF_DX11_0);
+    if (result == AMF_OK)
+        result = factory->pVtbl->CreateComponent(factory, codec->encoder_amf_context, component, &codec->encoder_amf);
+    virgl_info("AMF create component %ls: result=%d version=%llx\n", component, (int)result,
+               (unsigned long long)version);
+    if (result != AMF_OK)
+        encoder_close_amf(codec);
+    return result == AMF_OK ? S_OK : E_FAIL;
+}
+
+static HRESULT encoder_start_amf(struct virgl_video_codec *codec)
+{
+    AMFComponent *encoder = codec->encoder_amf;
+    const bool hevc = IsEqualGUID(&codec->encoder_output_guid, &VIRGL_MFVIDEOFORMAT_HEVC);
+    AMF_RESULT result;
+    AMFSize size = { codec->encoder_width, codec->encoder_height };
+    AMFRate rate = { codec->encoder_fps_num, codec->encoder_fps_den };
+
+    AMF_ASSIGN_PROPERTY_INT64(result, encoder,
+          hevc ? AMF_VIDEO_ENCODER_HEVC_TARGET_BITRATE : AMF_VIDEO_ENCODER_TARGET_BITRATE, codec->encoder_bitrate);
+    AMF_ASSIGN_PROPERTY_SIZE(result, encoder,
+          hevc ? AMF_VIDEO_ENCODER_HEVC_FRAMESIZE : AMF_VIDEO_ENCODER_FRAMESIZE, size);
+    AMF_ASSIGN_PROPERTY_RATE(result, encoder,
+          hevc ? AMF_VIDEO_ENCODER_HEVC_FRAMERATE : AMF_VIDEO_ENCODER_FRAMERATE, rate);
+    if (!hevc) {
+        AMF_ASSIGN_PROPERTY_INT64(result, encoder, AMF_VIDEO_ENCODER_B_PIC_PATTERN, 0);
+        AMF_ASSIGN_PROPERTY_INT64(result, encoder, AMF_VIDEO_ENCODER_PROFILE, AMF_VIDEO_ENCODER_PROFILE_MAIN);
+    }
+    if (getenv("WINQ_TEST_AMF_SPEED")) {
+        AMF_ASSIGN_PROPERTY_INT64(result, encoder,
+              hevc ? AMF_VIDEO_ENCODER_HEVC_QUALITY_PRESET : AMF_VIDEO_ENCODER_QUALITY_PRESET,
+              hevc ? AMF_VIDEO_ENCODER_HEVC_QUALITY_PRESET_SPEED : AMF_VIDEO_ENCODER_QUALITY_PRESET_SPEED);
+        virgl_info("AMF speed preset result=%d\n", (int)result);
+    }
+    const char *wait_mode = getenv("WINQ_TEST_AMF_WAIT");
+    const bool use_timer = wait_mode && strcmp(wait_mode, "sleep") != 0;
+    const bool use_native_wait = wait_mode && strcmp(wait_mode, "driver") == 0;
+    const wchar_t *query_timeout = hevc ? AMF_VIDEO_ENCODER_HEVC_QUERY_TIMEOUT :
+                                         AMF_VIDEO_ENCODER_QUERY_TIMEOUT;
+    AMF_ASSIGN_PROPERTY_INT64(result, encoder, query_timeout, use_native_wait ? 1 : 0);
+    AMFVariantStruct query_value = {0};
+    result = encoder->pVtbl->GetProperty(encoder, query_timeout, &query_value);
+    const int64_t query_wait = result == AMF_OK && query_value.type == AMF_VARIANT_INT64 ?
+                               query_value.int64Value : 0;
+    result = encoder->pVtbl->Init(encoder, AMF_SURFACE_NV12, size.width, size.height);
+    virgl_info("AMF init %s %dx%d %u/%u fps, result=%d\n", hevc ? "HEVC" : "H264",
+               size.width, size.height, rate.num, rate.den, (int)result);
+    if (result != AMF_OK)
+        return E_FAIL;
+
+    if (use_timer) {
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+        codec->amf_wait_timer = CreateWaitableTimerExW(NULL, NULL,
+              CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_MODIFY_STATE | SYNCHRONIZE);
+    }
+    codec->amf_wait_mode = query_wait ? "driver" : codec->amf_wait_timer ? "timer" : "sleep";
+    virgl_info("AMF polling mode=%s query_timeout_ms=%lld high_resolution_timer=%d\n",
+               codec->amf_wait_mode, (long long)query_wait, !!codec->amf_wait_timer);
+    codec->amf_frame_duration = UINT64_C(10000000) * rate.den / rate.num;
+    if (!codec->amf_frame_duration)
+        return E_INVALIDARG;
+    codec->encoder_stream_started = true;
+    return S_OK;
+}
+
+/* Queue the cropped NV12 copy on the same D3D11 context as AMF. UpdateSubresource
+ * consumes the CPU bytes before returning. D3D11 orders scratch texture reuse
+ * after the preceding copy, while AMF owns a separate destination per frame. */
+static HRESULT encoder_upload_amf_dx11(struct virgl_video_codec *codec,
+                                      struct virgl_video_buffer *source,
+                                      AMFSurface *surface)
+{
+    AMFContext *context = codec->encoder_amf_context;
+    AMFPlane *plane = surface->pVtbl->GetPlaneAt(surface, 0);
+    ID3D11Texture2D *dest = plane ? plane->pVtbl->GetNative(plane) : NULL;
+    D3D11_TEXTURE2D_DESC layout, scratch = {0};
+    const UINT left = codec->encoder_crop_left, top = codec->encoder_crop_top;
+    const UINT width = codec->encoder_width, height = codec->encoder_height;
+    const D3D11_BOX visible = { left, top, 0, left + width, top + height, 1 };
+    if (!dest || ((left | top | width | height | source->width | source->height) & 1))
+        return E_INVALIDARG;
+    ID3D11Texture2D_GetDesc(dest, &layout);
+    if (layout.Format != DXGI_FORMAT_NV12 || layout.Width < width || layout.Height < height ||
+        layout.ArraySize != 1 || layout.MipLevels != 1)
+        return E_INVALIDARG;
+    const bool direct = !left && !top &&
+        layout.Width == source->width && layout.Height == source->height;
+    if (!direct && codec->amf_upload_texture) {
+        ID3D11Texture2D_GetDesc(codec->amf_upload_texture, &scratch);
+        if (scratch.Width != source->width || scratch.Height != source->height) {
+            ID3D11Texture2D_Release(codec->amf_upload_texture);
+            codec->amf_upload_texture = NULL;
+        }
+    }
+    if (!direct && !codec->amf_upload_texture) {
+        const D3D11_TEXTURE2D_DESC desc = {
+            .Width = source->width, .Height = source->height, .MipLevels = 1,
+            .ArraySize = 1, .Format = DXGI_FORMAT_NV12, .SampleDesc = {1, 0},
+            .Usage = D3D11_USAGE_DEFAULT
+        };
+        HRESULT hr = ID3D11Device_CreateTexture2D(g_vid.device, &desc, NULL,
+                                                  &codec->amf_upload_texture);
+        if (FAILED(hr))
+            return hr;
+    }
+    if (context->pVtbl->LockDX11(context) != AMF_OK)
+        return E_FAIL;
+    ID3D11Texture2D *upload = direct ? dest : codec->amf_upload_texture;
+    ID3D11DeviceContext_UpdateSubresource(g_vid.context, (ID3D11Resource *)upload,
+                                         0, NULL, source->encode_src_nv12, source->width, 0);
+    if (!direct)
+        ID3D11DeviceContext_CopySubresourceRegion(g_vid.context, (ID3D11Resource *)dest,
+              0, 0, 0, 0, (ID3D11Resource *)upload, 0, &visible);
+    ID3D11DeviceContext_Flush(g_vid.context);
+    context->pVtbl->UnlockDX11(context);
+    return S_OK;
+}
+
+static HRESULT encoder_build_amf_surface(struct virgl_video_codec *codec,
+                                   struct virgl_video_buffer *source, bool keyframe,
+                                         AMFSurface **sample)
+{
+    AMFContext *context = codec->encoder_amf_context;
+    const bool hevc = IsEqualGUID(&codec->encoder_output_guid, &VIRGL_MFVIDEOFORMAT_HEVC);
+    const unsigned width = codec->encoder_width, height = codec->encoder_height;
+    const unsigned left = codec->encoder_crop_left, top = codec->encoder_crop_top;
+    const size_t pitch = source->width, luma = pitch * source->height;
+    AMFSurface *surface = NULL;
+    AMF_RESULT result;
+
+    *sample = NULL;
+    if (!source->encode_src_nv12 || source->encode_src_size < luma + luma / 2 ||
+        left + width > source->width || top + height > source->height)
+        return E_INVALIDARG;
+    result = context->pVtbl->AllocSurface(context, codec->amf_dx11_upload ? AMF_MEMORY_DX11 : AMF_MEMORY_HOST, AMF_SURFACE_NV12, width, height, &surface);
+    if (result != AMF_OK)
+        goto out;
+    if (codec->amf_dx11_upload) {
+        if (FAILED(encoder_upload_amf_dx11(codec, source, surface)))
+            goto out;
+    } else {
+        for (unsigned plane = 0; plane < 2; plane++) {
+            AMFPlane *layout = surface->pVtbl->GetPlaneAt(surface, plane);
+            if (!layout)
+                goto out;
+            const size_t dst_pitch = layout->pVtbl->GetHPitch(layout);
+            uint8_t *dst = layout->pVtbl->GetNative(layout);
+            const uint8_t *src = source->encode_src_nv12 + left + (plane ? luma + top / 2 * pitch : top * pitch);
+            if (!dst || dst_pitch < width)
+                goto out;
+            for (unsigned row = 0; row < (height >> plane); row++)
+                memcpy(dst + dst_pitch * row, src + pitch * row, width);
+        }
+    }
+    const amf_pts duration = codec->amf_frame_duration;
+    surface->pVtbl->SetPts(surface, codec->encoder_frame_count * duration);
+    surface->pVtbl->SetDuration(surface, duration);
+    if (keyframe || !codec->encoder_frame_count) {
+        if (hevc) {
+            AMF_ASSIGN_PROPERTY_INT64(result, surface, AMF_VIDEO_ENCODER_HEVC_FORCE_PICTURE_TYPE, AMF_VIDEO_ENCODER_HEVC_PICTURE_TYPE_IDR);
+            AMF_ASSIGN_PROPERTY_BOOL(result, surface, AMF_VIDEO_ENCODER_HEVC_INSERT_HEADER, true);
+        } else {
+            AMF_ASSIGN_PROPERTY_INT64(result, surface, AMF_VIDEO_ENCODER_FORCE_PICTURE_TYPE, AMF_VIDEO_ENCODER_PICTURE_TYPE_IDR);
+            AMF_ASSIGN_PROPERTY_BOOL(result, surface, AMF_VIDEO_ENCODER_INSERT_SPS, true);
+            AMF_ASSIGN_PROPERTY_BOOL(result, surface, AMF_VIDEO_ENCODER_INSERT_PPS, true);
+        }
+    }
+    *sample = surface;
+    return S_OK;
+
+out:
+    if (surface)
+        surface->pVtbl->Release(surface);
+    return E_FAIL;
+}
+
+static struct virgl_amf_entry *encoder_find_amf_entry(struct virgl_video_codec *codec,
+                                                       uint64_t ticket)
+{
+    for (unsigned i = 0; i < VIRGL_AMF_QUEUE_DEPTH; i++) {
+        struct virgl_amf_entry *entry = &codec->amf_pending[i];
+        if (entry->active && entry->ticket == ticket)
+            return entry;
+    }
+    return NULL;
+}
+
+/* AMF may return a different outstanding packet before the requested one.
+ * Preserve its identity and retain it until the guest fetches its own buffer. */
+static HRESULT encoder_poll_amf(struct virgl_video_codec *codec)
+{
+    AMFComponent *encoder = codec->encoder_amf;
+    AMFData *output = NULL;
+    const int64_t started = amf_now();
+    AMF_RESULT result = encoder->pVtbl->QueryOutput(encoder, &output);
+    codec->amf_profile.poll += amf_now() - started;
+    codec->amf_profile.polls++;
+    if (!output)
+        return result == AMF_REPEAT || result == AMF_OK ? S_FALSE : E_FAIL;
+
+    amf_pts pts = output->pVtbl->GetPts(output);
+    if (pts >= 0 && pts % codec->amf_frame_duration == 0) {
+        uint64_t ticket = pts / codec->amf_frame_duration;
+        struct virgl_amf_entry *entry = encoder_find_amf_entry(codec, ticket);
+        if (entry && !entry->output) {
+            entry->output = output;
+            codec->amf_profile.residence += amf_now() - entry->accepted_at;
+            return S_OK;
+        }
+    }
+    virgl_error("AMF returned an unexpected packet timestamp %lld\n", (long long)pts);
+    output->pVtbl->Release(output);
+    return E_FAIL;
+}
+
+static HRESULT encoder_submit_amf(struct virgl_video_codec *codec,
+                                  struct virgl_video_buffer *source, bool keyframe,
+                                  uint64_t *ticket)
+{
+    const uint64_t sequence = codec->encoder_frame_count;
+    AMFComponent *encoder = codec->encoder_amf;
+    struct virgl_amf_entry *entry = NULL;
+    AMFSurface *surface;
+    for (unsigned i = 0; i < VIRGL_AMF_QUEUE_DEPTH; i++) {
+        if (!codec->amf_pending[i].active) {
+            entry = &codec->amf_pending[i];
+            break;
+        }
+    }
+    if (!entry)
+        return E_FAIL;
+    const int64_t before_surface = amf_now();
+    HRESULT hr = encoder_build_amf_surface(codec, source, keyframe, &surface);
+    const int64_t before_submit = amf_now();
+    codec->amf_profile.surface += before_submit - before_surface;
+    if (FAILED(hr))
+        return hr;
+
+    const ULONGLONG deadline = GetTickCount64() + 3000;
+    AMF_RESULT result;
+    for (;;) {
+        result = encoder->pVtbl->SubmitInput(encoder, (AMFData *)surface);
+        if (result != AMF_INPUT_FULL)
+            break;
+        codec->amf_profile.input_full++;
+        hr = encoder_poll_amf(codec);
+        if (FAILED(hr) || GetTickCount64() >= deadline)
+            break;
+        if (hr == S_FALSE)
+            encoder_wait_amf(codec);
+    }
+    surface->pVtbl->Release(surface);
+    codec->amf_profile.submit += amf_now() - before_submit;
+    if (result != AMF_OK && result != AMF_NEED_MORE_INPUT) {
+        virgl_error("AMF could not submit frame %llu, result=%d\n",
+                    (unsigned long long)sequence, (int)result);
+        return E_FAIL;
+    }
+    entry->active = true;
+    entry->ticket = sequence;
+    entry->accepted_at = amf_now();
+    codec->encoder_frame_count++;
+    codec->amf_in_flight++;
+    if (codec->amf_in_flight > codec->amf_high_water) {
+        codec->amf_high_water = codec->amf_in_flight;
+        virgl_info("AMF pipeline outstanding=%u frame=%llu\n",
+                   codec->amf_high_water, (unsigned long long)sequence);
+    }
+    *ticket = sequence;
+    return S_OK;
+}
+
+int virgl_video_amf_collect(struct virgl_video_codec *codec, uint64_t ticket,
+                            const void **bytes, unsigned *length)
+{
+    struct virgl_amf_entry *entry = encoder_find_amf_entry(codec, ticket);
+    *bytes = NULL;
+    *length = 0;
+    if (!entry || codec->encoder_failed)
+        return -EIO;
+
+    const int64_t before_collect = amf_now();
+    const ULONGLONG deadline = GetTickCount64() + 3000;
+    while (!entry->output) {
+        HRESULT hr = encoder_poll_amf(codec);
+        if (FAILED(hr) || GetTickCount64() >= deadline) {
+            virgl_error("AMF could not complete frame %llu with %u outstanding\n",
+                        (unsigned long long)ticket, codec->amf_in_flight);
+            codec->encoder_failed = true;
+            return -EIO;
+        }
+        if (hr == S_FALSE)
+            encoder_wait_amf(codec);
+    }
+
+    AMFData *output = entry->output;
+    AMFBuffer *buffer = NULL;
+    const AMFGuid iid = IID_AMFBuffer();
+    if (output->pVtbl->QueryInterface(output, &iid, (void **)&buffer) == AMF_OK && buffer) {
+        size_t size = buffer->pVtbl->GetSize(buffer);
+        const void *data = buffer->pVtbl->GetNative(buffer);
+        if (data && size && size <= UINT_MAX) {
+            if (size > codec->encoder_coded_capacity) {
+                uint8_t *grown = realloc(codec->encoder_coded_buf, size);
+                if (grown) {
+                    codec->encoder_coded_buf = grown;
+                    codec->encoder_coded_capacity = size;
+                }
+            }
+            if (size <= codec->encoder_coded_capacity) {
+                memcpy(codec->encoder_coded_buf, data, size);
+                *bytes = codec->encoder_coded_buf;
+                *length = size;
+            }
+        }
+        buffer->pVtbl->Release(buffer);
+    }
+    output->pVtbl->Release(output);
+    entry->output = NULL;
+    entry->active = false;
+    codec->amf_in_flight--;
+    codec->amf_profile.last_completion = amf_now();
+    codec->amf_profile.collect += codec->amf_profile.last_completion - before_collect;
+    if (!*length) {
+        codec->encoder_failed = true;
+        return -EIO;
+    }
+    if (++codec->amf_profile.frames % 120 == 0)
+        encoder_log_amf_profile(codec, "sample");
+    return 0;
 }
 
