+/* One outstanding event subscription. The callback owns its event and keeps
+ * the generator alive even when a timed-out codec is being shut down. */
+struct encoder_event_wait {
+    IMFAsyncCallback callback;
+    LONG refs;
+    IMFMediaEventGenerator *generator;
+    HANDLE ready;
+    HRESULT result;
+    IMFMediaEvent *event;
+    bool pending;
+};
+
+static ULONG STDMETHODCALLTYPE encoder_event_add_ref(IMFAsyncCallback *callback)
+{
+    struct encoder_event_wait *wait = (struct encoder_event_wait *)callback;
+    return InterlockedIncrement(&wait->refs);
+}
+
+static ULONG STDMETHODCALLTYPE encoder_event_release(IMFAsyncCallback *callback)
+{
+    struct encoder_event_wait *wait = (struct encoder_event_wait *)callback;
+    LONG refs = InterlockedDecrement(&wait->refs);
+    if (!refs) {
+        if (wait->event)
+            IMFMediaEvent_Release(wait->event);
+        IMFMediaEventGenerator_Release(wait->generator);
+        CloseHandle(wait->ready);
+        free(wait);
+    }
+    return refs;
+}
+
+static HRESULT STDMETHODCALLTYPE encoder_event_query(IMFAsyncCallback *callback,
+                                                     REFIID iid, void **object)
+{
+    *object = NULL;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_IMFAsyncCallback))
+        return E_NOINTERFACE;
+    encoder_event_add_ref(callback);
+    *object = callback;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE encoder_event_parameters(IMFAsyncCallback *callback,
+                                                          DWORD *flags, DWORD *queue)
+{
+    (void)callback;
+    (void)flags;
+    (void)queue;
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE encoder_event_invoke(IMFAsyncCallback *callback,
+                                                       IMFAsyncResult *result)
+{
+    struct encoder_event_wait *wait = (struct encoder_event_wait *)callback;
+    wait->result = IMFMediaEventGenerator_EndGetEvent(wait->generator, result,
+                                                      &wait->event);
+    SetEvent(wait->ready);
+    return S_OK;
+}
+
+static IMFAsyncCallbackVtbl encoder_event_vtable = {
+    encoder_event_query, encoder_event_add_ref, encoder_event_release,
+    encoder_event_parameters, encoder_event_invoke,
+};
+
+static HRESULT encoder_event_create(struct virgl_video_codec *codec)
+{
+    struct encoder_event_wait *wait = calloc(1, sizeof(*wait));
+    if (!wait)
+        return E_OUTOFMEMORY;
+    wait->ready = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!wait->ready) {
+        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
+        free(wait);
+        return hr;
+    }
+    wait->callback.lpVtbl = &encoder_event_vtable;
+    wait->refs = 1;
+    wait->generator = codec->encoder_events;
+    IMFMediaEventGenerator_AddRef(wait->generator);
+    codec->encoder_wait = wait;
+    return S_OK;
+}
+
+static HRESULT encoder_next_event(struct encoder_event_wait *wait,
+                                  DWORD timeout, IMFMediaEvent **event)
+{
+    if (!wait->pending) {
+        HRESULT hr = IMFMediaEventGenerator_BeginGetEvent(wait->generator,
+                                                          &wait->callback, NULL);
+        if (FAILED(hr))
+            return hr;
+        wait->pending = true;
+    }
+
+    /* SDL can own this render thread's single-threaded COM apartment.
+     * Dispatch COM calls while waiting so MFT worker threads can call it. */
+    DWORD index;
+    HRESULT ready = CoWaitForMultipleHandles(0, timeout, 1, &wait->ready, &index);
+    if (ready == RPC_S_CALLPENDING)
+        return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    if (FAILED(ready))
+        return ready;
+
+    wait->pending = false;
+    *event = wait->event;
+    wait->event = NULL;
+    return wait->result;
+}
