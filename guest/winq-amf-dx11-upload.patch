+static void encoder_log_amf_profile(const struct virgl_video_codec *codec, const char *reason)
+{
+    const struct amf_profile *p = &codec->amf_profile;
+    if (!p->frames)
+        return;
+    LARGE_INTEGER frequency;
+    QueryPerformanceFrequency(&frequency);
+    const double ms = 1000.0 / frequency.QuadPart;
+    const bool hevc = IsEqualGUID(&codec->encoder_output_guid, &VIRGL_MFVIDEOFORMAT_HEVC);
+    virgl_info("AMF profile %s mode=%s reason=%s frames=%u depth=%u "
+               "readback_ms=%.3f surface_ms=%.3f submit_ms=%.3f collect_ms=%.3f "
+               "poll_ms=%.3f wait_ms=%.3f residence_ms=%.3f worst_wait_ms=%.3f "
+               "span_ms=%.3f polls=%u waits=%u full=%u\n",
+               hevc ? "HEVC" : "H264", codec->amf_wait_mode, reason,
+               p->frames, codec->amf_high_water, p->readback * ms, p->surface * ms,
+               p->submit * ms, p->collect * ms, p->poll * ms, p->wait * ms,
+               p->residence * ms, p->max_wait * ms,
+               (p->last_completion - p->first_submission) * ms, p->polls, p->waits, p->input_full);
+}
