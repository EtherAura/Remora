+/* The guest can pad its video surfaces beyond the visible frame. Pass the
+ * visible NV12 region to the hardware encoder so its own SPS signals the
+ * right display dimensions. Offsets are in 4:2:0 chroma samples. */
+static bool encoder_set_visible_geometry(struct virgl_video_codec *codec,
+                                         const struct virgl_video_buffer *source,
+                                         unsigned width, unsigned height,
+                                         uint32_t left, uint32_t right,
+                                         uint32_t top, uint32_t bottom)
+{
+    if (width > source->width || height > source->height ||
+        (width % 2) || (height % 2) ||
+        left >= width / 2 || right >= width / 2 - left ||
+        top >= height / 2 || bottom >= height / 2 - top)
+        return false;
+
+    width -= 2 * (left + right);
+    height -= 2 * (top + bottom);
+    codec->encoder_crop_left = 2 * left;
+    codec->encoder_crop_top = 2 * top;
+    if (codec->encoder_width == width && codec->encoder_height == height)
+        return false;
+    virgl_info("virgl_video_win32: encoder visible frame %ux%u at %u,%u\n",
+               width, height, codec->encoder_crop_left, codec->encoder_crop_top);
+    codec->encoder_width = width;
+    codec->encoder_height = height;
+    return true;
+}
+
+static bool encoder_set_hevc_geometry(struct virgl_video_codec *codec,
+                                      const struct virgl_video_buffer *source,
+                                      const struct virgl_h265_enc_seq_param *seq)
+{
+    if (seq->chroma_format_idc != 1)
+        return false;
+
+    const bool crop = seq->conformance_window_flag;
+    return encoder_set_visible_geometry(codec, source,
+                                       seq->pic_width_in_luma_samples,
+                                       seq->pic_height_in_luma_samples,
+                                       crop ? seq->conf_win_left_offset : 0,
+                                       crop ? seq->conf_win_right_offset : 0,
+                                       crop ? seq->conf_win_top_offset : 0,
+                                       crop ? seq->conf_win_bottom_offset : 0);
+}
+
+static bool encoder_set_avc_geometry(struct virgl_video_codec *codec,
+                                     const struct virgl_video_buffer *source,
+                                     const struct virgl_h264_enc_seq_param *seq)
+{
+    if (!seq->enc_frame_cropping_flag)
+        return false;
+
+    /* VirGL carries the macroblock-aligned AVC size in CREATE_VIDEO_CODEC.
+     * The MFT receives progressive 4:2:0, so each crop unit is two pixels. */
+    return encoder_set_visible_geometry(codec, source, codec->width, codec->height,
+                                       seq->enc_frame_crop_left_offset,
+                                       seq->enc_frame_crop_right_offset,
+                                       seq->enc_frame_crop_top_offset,
+                                       seq->enc_frame_crop_bottom_offset);
+}
