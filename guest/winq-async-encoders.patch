+static HRESULT encoder_configure_async(struct virgl_video_codec *codec)
+{
+    IMFAttributes *attributes;
+    UINT32 async = 0;
+    HRESULT hr = IMFTransform_GetAttributes(codec->encoder_mft, &attributes);
+
+    if (hr == E_NOTIMPL)
+        return S_OK;
+    if (FAILED(hr))
+        return hr;
+    hr = IMFAttributes_GetUINT32(attributes, &MF_TRANSFORM_ASYNC, &async);
+    if (SUCCEEDED(hr) && async)
+        hr = IMFAttributes_SetUINT32(attributes, &MF_TRANSFORM_ASYNC_UNLOCK, TRUE);
+    IMFAttributes_Release(attributes);
+    if (hr == MF_E_ATTRIBUTENOTFOUND || (SUCCEEDED(hr) && !async))
+        return S_OK;
+    if (FAILED(hr))
+        return hr;
+
+    hr = IMFTransform_QueryInterface(codec->encoder_mft, &IID_IMFMediaEventGenerator,
+                                     (void **)&codec->encoder_events);
+    if (FAILED(hr))
+        return hr;
+
+    /* VirGL supplies one destination and feedback resource for each input.
+     * Ask the MFT for low latency without reordering so each frame can
+     * complete before returning those resources to the guest. */
+    ICodecAPI *api;
+    if (SUCCEEDED(IMFTransform_QueryInterface(codec->encoder_mft, &IID_ICodecAPI,
+                                              (void **)&api))) {
+        /* MinGW exposes the B-picture property through a C++-only macro. */
+        static const GUID b_picture_count = {
+            0x8d390aac, 0xdc5c, 0x4200, {0xb5, 0x7f, 0x81, 0x4d, 0x04, 0xba, 0xba, 0xb2}
+        };
+        VARIANT value = {0};
+        V_VT(&value) = VT_BOOL;
+        V_BOOL(&value) = VARIANT_TRUE;
+        /* CODECAPI_AVLowLatencyMode and MF_LOW_LATENCY share this GUID. */
+        ICodecAPI_SetValue(api, &VIRGL_MF_LOW_LATENCY, &value);
+        V_VT(&value) = VT_UI4;
+        V_UI4(&value) = 0;
+        ICodecAPI_SetValue(api, &b_picture_count, &value);
+        ICodecAPI_Release(api);
+    }
+    virgl_info("virgl_video_win32: unlocked asynchronous encoder MFT\n");
+    return S_OK;
+}
