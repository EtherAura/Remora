+/* Submit both plane transfers before waiting for their data. The reusable
+ * pack buffer belongs to this video buffer and its renderer GL context. */
+static bool read_nv12_pack_buffer(struct vrend_video_buffer *buf,
+                                  struct vrend_resource *y, size_t y_size)
+{
+    struct vrend_resource *uv = vrend_renderer_ctx_res_lookup(
+            buf->ctx->ctx, buf->planes[1].res_handle);
+    if (!uv || y->target != GL_TEXTURE_2D || uv->target != GL_TEXTURE_2D ||
+        (y->base.width0 & 1) || (y->base.height0 & 1) ||
+        uv->base.width0 != y->base.width0 / 2 ||
+        uv->base.height0 != y->base.height0 / 2 || y_size > INT32_MAX / 2)
+        return false;
+
+    const size_t size = y_size + y_size / 2;
+    GLint prev_pack, prev_texture, alignment, row_length, skip_rows, skip_pixels;
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &prev_pack);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prev_texture);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &row_length);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skip_rows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skip_pixels);
+
+    bool ok = false;
+    if (!buf->encode_pack_buffer)
+        glGenBuffers(1, &buf->encode_pack_buffer);
+    if (!buf->encode_pack_buffer)
+        return false;
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, buf->encode_pack_buffer);
+    if (buf->encode_pack_size != size) {
+        glBufferData(GL_PIXEL_PACK_BUFFER, size, NULL, GL_STREAM_READ);
+        if (glGetError() != GL_NO_ERROR)
+            goto restore;
+        buf->encode_pack_size = size;
+    }
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glBindTexture(GL_TEXTURE_2D, y->gl_id);
+    glGetTexImage(GL_TEXTURE_2D, 0, GL_RED, GL_UNSIGNED_BYTE, NULL);
+    glBindTexture(GL_TEXTURE_2D, uv->gl_id);
+    glGetTexImage(GL_TEXTURE_2D, 0, GL_RG, GL_UNSIGNED_BYTE, (void *)(uintptr_t)y_size);
+    if (glGetError() != GL_NO_ERROR)
+        goto restore;
+    const void *mapped = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, size, GL_MAP_READ_BIT);
+    if (mapped) {
+        ok = virgl_video_buffer_cpu_writeback(buf->buffer, mapped, size) == 0;
+        if (!glUnmapBuffer(GL_PIXEL_PACK_BUFFER))
+            ok = false;
+    }
+
+restore:
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, prev_pack);
+    glBindTexture(GL_TEXTURE_2D, prev_texture);
+    glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    glPixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+    return ok;
+}
+
 /*
